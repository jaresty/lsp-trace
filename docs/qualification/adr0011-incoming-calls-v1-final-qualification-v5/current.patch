+	}
+	for {
+		if used >= len(header) || int64(used) >= r.limits.MaxHeaderBytes {
+			return retainHeader(ErrHeaderTooLarge)
+		}
+		c, err := r.r.ReadByte()
+		if err != nil {
+			return retainHeader(err)
+		}
+		header[used] = c
+		used++
+		if c != '\n' {
+			continue
+		}
+		line := strings.TrimRight(string(header[lineStart:used]), "\r\n")
+		lineStart = used
+		if line == "" {
