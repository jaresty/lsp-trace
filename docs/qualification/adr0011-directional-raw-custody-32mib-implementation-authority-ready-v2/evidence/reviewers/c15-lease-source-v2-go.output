{"isSidechain":true,"agentId":"73ef3d2e-c865-43f","type":"toolResult","message":{"role":"toolResult","toolCallId":"call_ba9bbad3a1e8418897959f510558fa48|fc_07dc770452ad3266016ace47d134d081a29b002d4db0de56db","toolName":"bash","content":[{"type":"text","text":"1\tpackage lspwire\n2\t\n3\timport (\n4\t\t\"crypto/sha256\"\n5\t\t\"encoding/hex\"\n6\t\t\"errors\"\n7\t\t\"hash\"\n8\t)\n9\t\n10\tvar (\n11\t\tErrInvalidFrameCaptureLimit = errors.New(\"invalid frame capture limit\")\n12\t\tErrFrameCaptureLimit        = errors.New(\"frame capture limit exceeded\")\n13\t)\n14\t\n15\t// ReadFrameObservation is local evidence about one complete decoded frame.\n16\t// It contains no raw bytes and does not authenticate the sender.\n17\ttype ReadFrameObservation struct {\n18\t\tFrameBytes  int64\n19\t\tFrameSHA256 string\n20\t}\n21\t\n22\t// framedReadCapture hashes only bytes consumed for this frame, not bytes that\n23\t// bufio.Reader may have prefetched from later messages. Raw retention is opt-in.\n24\ttype framedReadCapture struct {\n25\t\tdigest    hash.Hash\n26\t\tbytes     int64\n27\t\tmaxRaw    int64\n28\t\tonRetain  func() // optional test-only notification before each raw append\n29\t\traw       []byte\n30\t\toverLimit bool\n31\t}\n32\t\n33\tfunc (c *framedReadCapture) add(p []byte) {\n34\t\t_, _ = c.digest.Write(p)\n35\t\tc.bytes += int64(len(p))\n36\t\tif c.maxRaw <= 0 || c.overLimit {\n37\t\t\treturn\n38\t\t}\n39\t\tif int64(len(p)) > c.maxRaw-int64(len(c.raw)) {\n40\t\t\tc.raw = nil\n41\t\t\tc.overLimit = true\n42\t\t\treturn\n43\t\t}\n44\t\tif c.onRetain != nil {\n45\t\t\tfunc() {\n46\t\t\t\tdefer func() { _ = recover() }()\n47\t\t\t\tc.onRetain()\n48\t\t\t}()\n49\t\t}\n50\t\tc.raw = append(c.raw, p...)\n51\t}\n52\t\n53\t// ReadWithExactFrame returns a private, in-memory copy of the exact consumed\n54\t// header and body only for a valid frame within maxBytes. A failed or over-cap\n55\t// read returns no message, observation, or bytes; an invalid cap reads nothing.\n56\t// The cap limits retained bytes, not total reader allocation or wire resources.\n57\t// This method neither persists evidence nor attests to its producer.\n58\t// Like Read, this Reader has one consumer and may not be read concurrently.\n59\tfunc (r *Reader) ReadWithExactFrame(maxBytes int64) (Message, ReadFrameObservation, []byte, error) {\n60\t\tif maxBytes <= 0 {\n61\t\t\treturn Message{}, ReadFrameObservation{}, nil, ErrInvalidFrameCaptureLimit\n62\t\t}\n63\t\tcapture := &framedReadCapture{digest: sha256.New(), maxRaw: maxBytes, onRetain: r.retainEntry}\n64\t\tr.frameCapture = capture\n65\t\tdefer func() { r.frameCapture = nil }()\n66\t\tmessage, err := r.Read()\n67\t\tif err != nil {\n68\t\t\treturn Message{}, ReadFrameObservation{}, nil, err\n69\t\t}\n70\t\tif capture.overLimit {\n71\t\t\treturn Message{}, ReadFrameObservation{}, nil, ErrFrameCaptureLimit\n72\t\t}\n73\t\treturn message, ReadFrameObservation{\n74\t\t\tFrameBytes:  capture.bytes,\n75\t\t\tFrameSHA256: \"sha256:\" + hex.EncodeToString(capture.digest.Sum(nil)),\n76\t\t}, append([]byte(nil), capture.raw...), nil\n77\t}\n78\t\n79\t// ReadWithFrameIfWithin is an opt-in in-memory read for deferred frame\n80\t// selection. Valid over-cap frames remain decoded and observable, but return no\n81\t// raw bytes; only a valid within-cap frame returns an independent raw copy.\n82\t// The cap bounds retained raw bytes, not total reader allocation or wire work.\n83\t// It neither persists evidence nor identifies the accepted request by itself.\n84\tfunc (r *Reader) ReadWithFrameIfWithin(maxBytes int64) (Message, ReadFrameObservation, []byte, bool, error) {\n85\t\tif maxBytes <= 0 {\n86\t\t\treturn Message{}, ReadFrameObservation{}, nil, false, ErrInvalidFrameCaptureLimit\n87\t\t}\n88\t\tcapture := &framedReadCapture{digest: sha256.New(), maxRaw: maxBytes, onRetain: r.retainEntry}\n89\t\tr.frameCapture = capture\n90\t\tdefer func() { r.frameCapture = nil }()\n91\t\tmessage, err := r.Read()\n92\t\tif err != nil {\n93\t\t\treturn Message{}, ReadFrameObservation{}, nil, false, err\n94\t\t}\n95\t\tobserved := ReadFrameObservation{\n96\t\t\tFrameBytes:  capture.bytes,\n97\t\t\tFrameSHA256: \"sha256:\" + hex.EncodeToString(capture.digest.Sum(nil)),\n98\t\t}\n99\t\tif capture.overLimit {\n100\t\t\treturn message, observed, nil, false, nil\n101\t\t}\n102\t\treturn message, observed, append([]byte(nil), capture.raw...), true, nil\n103\t}\n104\t\n105\t// ReadWithFrame returns an observation only after a complete valid message.\n106\t// Reader has the same single-consumer ownership requirement as Read; neither\n107\t// method may be called concurrently on one Reader.\n108\tfunc (r *Reader) ReadWithFrame() (Message, ReadFrameObservation, error) {\n109\t\tcapture := &framedReadCapture{digest: sha256.New()}\n110\t\tr.frameCapture = capture\n111\t\tdefer func() { r.frameCapture = nil }()\n112\t\tmessage, err := r.Read()\n113\t\tif err != nil {\n114\t\t\treturn Message{}, ReadFrameObservation{}, err\n115\t\t}\n116\t\treturn message, ReadFrameObservation{\n117\t\t\tFrameBytes:  capture.bytes,\n118\t\t\tFrameSHA256: \"sha256:\" + hex.EncodeToString(capture.digest.Sum(nil)),\n119\t\t}, nil\n120\t}\n\n## Related notes\n- 20260831011615-9785 — Correction orientation selects one genuine root-to-workflow messaging pilot [possibly relevant]\n- 20260920161428-8415 — Integration receipt: Terra f1505948-5f01-472: authorized repaired Qwen replay, raw capture, and prompt-eval preparation. [possibly relevant]\n- 20260922094528-6377 — Integration receipt: Fix nil required_targets producer after live seed_manifest null diagnosis [possibly relevant]\n- 20261005043636-1438 — Integration receipt: Independently review accepted-success private definition decoded-message custody [possibly relevant]\n- 20261004222557-4857 — Integration receipt: Independent read-only integration review of ADR0011 C15 private-B4 returned request-frame ownership via bounded caller lease [possibly relevant]\nResolve each unread related note — run `nn show <id>` to open, or write `skip-related: <id> [<id> ...] — <reason>` to dismiss. Notes marked [read] have already been loaded this session and do not require action.\n"}],"isError":false,"timestamp":1791903698266},"timestamp":"2026-10-13T15:01:38.270Z","cwd":"/Users/schwa/dev/lsp-trace"}
{"isSidechain":true,"agentId":"73ef3d2e-c865-43f","type":"toolResult","message":{"role":"toolResult","toolCallId":"call_4fe1799ece5a426ca9b9ddb9df040b11|fc_07dc770452ad3266016ace47d134d081a2934bc21bbd4c7829","toolName":"bash","content":[{"type":"text","text":"360\t\t\treturn\n361\t\t}\n362\t\tr.allocationClosed = true\n363\t\tif r.prefetchAllocation != nil {\n364\t\t\tr.prefetchAllocation.Release()\n365\t\t\tr.prefetchAllocation = nil\n366\t\t}\n367\t}\n368\t\n369\ttype ingressReached struct {\n370\t\tPreflight, Deadline, Cancellation, Header, Frame, Reserve, Acquisition, Consumption, ShortEOF, Transport, Decode, MessageAttempts error\n371\t\tSuccess                                                                                                                           bool\n372\t}\n373\ttype ingressSelection struct {\n374\t\tKind ingressOutcome\n375\t\tErr  error\n376\t}\n377\t\n378\tfunc (r *SuccessorIngressReader) selectReached(x ingressReached) ingressSelection {\n379\t\tfor _, c := range []struct {\n380\t\t\tk ingressOutcome\n381\t\t\te error\n382\t\t}{{ingressOutcomePreflight, x.Preflight}, {ingressOutcomeDeadline, x.Deadline}, {ingressOutcomeCancellation, x.Cancellation}, {ingressOutcomeHeaderLimit, x.Header}, {ingressOutcomeFrameLimit, x.Frame}, {ingressOutcomeReserveStorage, x.Reserve}, {ingressOutcomeAcquisitionLimit, x.Acquisition}, {ingressOutcomeConsumptionLimit, x.Consumption}, {ingressOutcomeTransportShortEOF, x.ShortEOF}, {ingressOutcomeTransport, x.Transport}, {ingressOutcomeDecodeValidation, x.Decode}, {ingressOutcomeMessageAttempts, x.MessageAttempts}} {\n383\t\t\tif c.e != nil {\n384\t\t\t\treturn ingressSelection{c.k, c.e}\n385\t\t\t}\n386\t\t}\n387\t\tif x.Success {\n388\t\t\treturn ingressSelection{ingressOutcomeSuccess, nil}\n389\t\t}\n390\t\treturn ingressSelection{}\n391\t}\n392\tfunc (r *SuccessorIngressReader) terminate(x ingressReached) ingressStepResult {\n393\t\ts := r.selectReached(x)\n394\t\tif s.Kind == ingressOutcomeSuccess {\n395\t\t\treturn ingressStepResult{OutcomeKind: s.Kind}\n396\t\t}\n397\t\treturn r.seal(s.Kind, s.Err)\n398\t}\n399\tfunc (r *SuccessorIngressReader) terminateTransport(err error) ingressStepResult {\n400\t\tif transportOutcome(err, false) == ingressOutcomeTransportShortEOF {\n401\t\t\treturn r.terminate(ingressReached{ShortEOF: err})\n402\t\t}\n403\t\treturn r.terminate(ingressReached{Transport: err})\n404\t}\n405\tfunc (r *SuccessorIngressReader) reserve(capacity uint64, role ingressStorageRole) bool {\n406\t\tr.nextStorageID++\n407\t\treturn r.storage.reserveNew(r.nextStorageID, capacity, role)\n408\t}\n409\t\n410\tfunc (r *SuccessorIngressReader) seal(k ingressOutcome, err error) ingressStepResult {\n411\t\tif !r.sealed {\n412\t\t\tr.sealed = true\n413\t\t\tr.terminalOutcome = k\n414\t\t\tr.observe(ingressEvent{Stage: ingressEventSeal, Supported: ingressSupportTerminal, Present: ingressSupportTerminal, Outcome: k})\n415\t\t}\n416\t\tr.observe(ingressEvent{Stage: ingressEventOutcome, Supported: ingressSupportTerminal, Present: ingressSupportTerminal, Outcome: k})\n417\t\treturn ingressStepResult{Outcome: err, OutcomeKind: k}\n418\t}\n419\tfunc (r *SuccessorIngressReader) step(in ingressStepInput) ingressStepResult {\n420\t\tif r.sealed {\n421\t\t\treturn ingressStepResult{Outcome: errIngressSealed, OutcomeKind: ingressOutcomeRefusedSealed}\n422\t\t}\n423\t\tif in.Checkpoint == ingressPreRead {\n424\t\t\tif in.Known.Preflight != nil {\n425\t\t\t\treturn r.terminate(ingressReached{Preflight: in.Known.Preflight})\n426\t\t\t}\n427\t\t\tif r.acquired >= r.options.Limits.AcquisitionBytes {\n428\t\t\t\treturn r.terminate(ingressReached{Acquisition: errIngressAcquire})\n429\t\t\t}\n430\t\t\troom := 4096 - len(r.prefetch)\n431\t\t\tn := room\n432\t\t\tif n > int(r.options.Limits.MaxReadBytes) {\n433\t\t\t\tn = int(r.options.Limits.MaxReadBytes)\n434\t\t\t}\n435\t\t\tif rem := int(r.options.Limits.AcquisitionBytes - r.acquired); n > rem {\n436\t\t\t\tn = rem\n437\t\t\t}\n438\t\t\tif rem := int(r.options.Limits.ConsumptionBytes-r.consumed) + 1; n > rem {\n439\t\t\t\tn = rem\n440\t\t\t}\n441\t\t\tneed := in.HeaderRemaining\n442\t\t\tif in.BodyRemaining > 0 {\n443\t\t\t\tneed = in.BodyRemaining\n444\t\t\t}\n445\t\t\tif need > 0 && n > need {\n446\t\t\t\tn = need\n447\t\t\t}\n448\t\t\treturn ingressStepResult{NeedRead: n}\n449\t\t}\n450\t\tif in.Checkpoint == ingressPostRead {\n451\t\t\tbeforeA := r.acquired\n452\t\t\tbeforeU := len(r.prefetch)\n453\t\t\tif in.ReadDirect {\n454\t\t\t\tbeforeU = in.BeforeUnread\n455\t\t\t}\n456\t\t\tif uint64(len(in.Returned)) > r.options.Limits.AcquisitionBytes-r.acquired {\n457\t\t\t\treturn r.terminate(ingressReached{Acquisition: errIngressAcquire})\n458\t\t\t}\n459\t\t\tif !in.ReadDirect && len(in.Returned) > cap(r.prefetch)-len(r.prefetch) {\n460\t\t\t\treturn r.terminate(ingressReached{Reserve: errIngressReserve})\n461\t\t\t}\n462\t\t\tr.acquired += uint64(len(in.Returned))\n463\t\t\tif !in.ReadDirect {\n464\t\t\t\tr.prefetch = append(r.prefetch, in.Returned...)\n465\t\t\t}\n466\t\t\tr.observe(ingressEvent{Stage: ingressEventRead, Supported: ingressSupportLedger | ingressSupportPrefetch, Present: ingressSupportLedger | ingressSupportPrefetch, Requested: in.Requested, ReadN: len(in.Returned), BeforeA: beforeA, AfterA: r.acquired, BeforeUnread: beforeU, AfterUnread: len(r.prefetch)})\n467\t\t\tif in.Known.Preflight != nil {\n468\t\t\t\treturn r.terminate(ingressReached{Preflight: in.Known.Preflight})\n469\t\t\t}\n470\t\t\tif in.Known.Deadline != nil {\n471\t\t\t\treturn r.terminate(ingressReached{Deadline: in.Known.Deadline})\n472\t\t\t}\n473\t\t\tif in.Known.Cancellation != nil {\n474\t\t\t\treturn r.terminate(ingressReached{Cancellation: in.Known.Cancellation})\n475\t\t\t}\n476\t\t}\n477\t\tif in.Checkpoint == ingressConsume {\n478\t\t\tn := in.Consume\n479\t\t\tif n > len(r.prefetch) {\n480\t\t\t\tn = len(r.prefetch)\n481\t\t\t}\n482\t\t\tallowed := int(r.options.Limits.ConsumptionBytes-r.consumed) + 1