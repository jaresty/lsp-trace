{
  "version": 1,
  "processes": [
    {
      "alias": "ember-b05",
      "profile": {
        "trust_domain": "b05-production-lifecycle",
        "workspace": "${B05_WORKSPACE}",
        "profile": "ember-glint",
        "environment_reference": "release-qualification"
      },
      "execution": {
        "path": "${B05_LANGUAGE_SERVER_BINARY}",
        "directory": "${B05_WORKSPACE}"
      }
    }
  ],
  "providers": [
    {
      "schema_version": "lsp-trace.bootstrap-provider.v1",
      "identity": "ember-glint@1",
      "version": "1",
      "protocol": {
        "name": "lsp-trace.provider-observations",
        "version": "1"
      },
      "execution": {
        "path": "${LSP_TRACE_EMBER_PROVIDER_BINARY}",
        "directory": "${B05_WORKSPACE}"
      },
      "capabilities": {
        "relations": ["BINDS_ARGUMENT", "PASSES_CALLBACK", "INVOKES_TASK", "TRIGGERS_RELOAD", "UPDATES_STATE", "RENDERS_FROM"],
        "languages": ["javascript", "typescript", "handlebars"],
        "frameworks": ["ember", "glimmer"]
      },
      "limits": {
        "request_bytes": 1048576,
        "response_bytes": 8388608,
        "protocol_messages": 2,
        "stderr_bytes": 65536,
        "wall_time_ms": 30000,
        "termination_grace_ms": 1000
      }
    }
  ]
}
