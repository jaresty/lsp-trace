{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/qualification/proposed/adr0011-definition-result.v1.schema.json",
  "title": "Proposed ADR0011 complete definition result shape; not an admission receipt",
  "$comment": "JSON Schema validates decoded structure only. Duplicate keys, exact raw bytes, canonical URI, source boundaries, range ordering/containment and origin equality require an independent strict parser and source verifier. This schema neither registers a production role nor proves a complete wire response.",
  "oneOf": [
    { "type": "null" },
    { "$ref": "#/$defs/location" },
    { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/location" } },
    { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/locationLink" } }
  ],
  "$defs": {
    "position": { "type": "object", "additionalProperties": false, "required": ["line", "character"], "properties": { "line": { "type": "integer", "minimum": 0 }, "character": { "type": "integer", "minimum": 0 } } },
    "range": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/position" }, "end": { "$ref": "#/$defs/position" } } },
    "location": { "type": "object", "additionalProperties": false, "required": ["uri", "range"], "properties": { "uri": { "type": "string", "minLength": 1 }, "range": { "$ref": "#/$defs/range" } } },
    "locationLink": { "type": "object", "additionalProperties": false, "required": ["targetUri", "targetRange", "targetSelectionRange"], "properties": { "targetUri": { "type": "string", "minLength": 1 }, "targetRange": { "$ref": "#/$defs/range" }, "targetSelectionRange": { "$ref": "#/$defs/range" }, "originSelectionRange": { "$ref": "#/$defs/range" } } }
  }
}
