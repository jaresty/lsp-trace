{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///private/tmp/adr0011-gopls-workload-study-v1/workspace/internal/sourceadmissionv2/admission.go","languageId":"go","version":1,"text":"// Package sourceadmissionv2 defines immutable exact source admission for ADR0007 Location v2.\npackage sourceadmissionv2\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"golang.org/x/text/unicode/norm\"\n\t\"path\"\n\t\"sort\"\n\t\"strings\"\n\t\"unicode/utf8\"\n)\n\nconst Schema = \"lsp-trace.adr0007.source-admission.private.v2\"\n\ntype Outcome string\n\nconst (\n\tComplete        Outcome = \"COMPLETE\"\n\tInvalidRequest  Outcome = \"INVALID_REQUEST\"\n\tInvalidSource   Outcome = \"INVALID_SOURCE\"\n\tDuplicateSource Outcome = \"DUPLICATE_SOURCE\"\n\tResourceLimit   Outcome = \"RESOURCE_LIMIT\"\n)\n\ntype Limits struct {\n\tMaxSources, MaxSourceBytes, MaxTotalBytes int `json:\"-\"`\n}\ntype SelectedSource struct {\n\tPath         string `json:\"path\"`\n\tRevision     string `json:\"revision\"`\n\tFileDigest   string `json:\"fileDigest\"`\n\tObjectDigest string `json:\"objectDigest\"`\n\tBytes        []byte `json:\"bytes\"`\n}\ntype Binding struct {\n\tSchema          string           `json:\"schema\"`\n\tAdmissionDigest string           `json:\"admissionDigest\"`\n\tSources         []SelectedSource `json:\"sources\"`\n}\ntype Result struct {\n\tOutcome Outcome\n\tBinding *Binding\n\tDetail  string\n}\n\nfunc Admit(in []SelectedSource, l Limits) Result {\n\tif len(in) == 0 || l.MaxSources < 1 || l.MaxSourceBytes < 1 || l.MaxTotalBytes < 1 {\n\t\treturn Result{Outcome: InvalidRequest, Detail: \"limits or sources\"}\n\t}\n\tif len(in) > l.MaxSources {\n\t\treturn Result{Outcome: ResourceLimit, Detail: \"sources\"}\n\t}\n\tout := make([]SelectedSource, len(in))\n\tseen := map[string]bool{}\n\ttotal := 0\n\tfor i, s := range in {\n\t\tif !CanonicalPath(s.Path) || s.Revision == \"\" || len(s.Bytes) == 0 || !utf8.Valid(s.Bytes) || len(s.Bytes) > l.MaxSourceBytes {\n\t\t\treturn Result{Outcome: InvalidSource, Detail: \"binding\"}\n\t\t}\n\t\tif seen[s.Path] {\n\t\t\treturn Result{Outcome: DuplicateSource, Detail: s.Path}\n\t\t}\n\t\tseen[s.Path] = true\n\t\ttotal += len(s.Bytes)\n\t\tif total > l.MaxTotalBytes {\n\t\t\treturn Result{Outcome: ResourceLimit, Detail: \"bytes\"}\n\t\t}\n\t\td := Digest(s.Bytes)\n\t\tif s.FileDigest != \"\" && s.FileDigest != d {\n\t\t\treturn Result{Outcome: InvalidSource, Detail: \"file digest\"}\n\t\t}\n\t\tif s.ObjectDigest != \"\" && s.ObjectDigest != d {\n\t\t\treturn Result{Outcome: InvalidSource, Detail: \"object digest\"}\n\t\t}\n\t\ts.FileDigest = d\n\t\ts.ObjectDigest = d\n\t\ts.Bytes = append([]byte(nil), s.Bytes...)\n\t\tout[i] = s\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Path < out[j].Path })\n\th := sha256.New()\n\th.Write([]byte(Schema))\n\tfor _, s := range out {\n\t\tfor _, v := range []string{s.Path, s.Revision, s.FileDigest, s.ObjectDigest} {\n\t\t\th.Write([]byte{0})\n\t\t\th.Write([]byte(v))\n\t\t}\n\t}\n\treturn Result{Outcome: Complete, Binding: &Binding{Schema: Schema, AdmissionDigest: \"sha256:\" + hex.EncodeToString(h.Sum(nil)), Sources: out}}\n}\nfunc Clone(b *Binding) *Binding {\n\tif b == nil {\n\t\treturn nil\n\t}\n\to := &Binding{Schema: b.Schema, AdmissionDigest: b.AdmissionDigest, Sources: append([]SelectedSource(nil), b.Sources...)}\n\tfor i := range o.Sources {\n\t\to.Sources[i].Bytes = append([]byte(nil), o.Sources[i].Bytes...)\n\t}\n\treturn o\n}\nfunc CanonicalPath(p string) bool {\n\treturn p != \"\" && utf8.ValidString(p) && norm.NFC.IsNormalString(p) && !strings.Contains(p, \"\\\\\") && !strings.Contains(p, \"//\") && !strings.Contains(p, \":\") && !strings.HasPrefix(p, \"/\") && p != \".\" && p != \"..\" && !strings.HasPrefix(p, \"./\") && !strings.HasPrefix(p, \"../\") && !strings.Contains(p, \"/./\") && !strings.Contains(p, \"/../\") && path.Clean(p) == p\n}\nfunc Digest(b []byte) string { s := sha256.Sum256(b); return \"sha256:\" + hex.EncodeToString(s[:]) }\n"}}}