signing harness file generation workflow**\"}]}"},{"type":"text","text":"Observation 6 — every dependency and production-source hash exactly matches `DEPENDENCIES.sha256`; the only worktree changes are the 11 V3 package files; diff hygiene passes. This confirms the exact six production paths are the sole pinned production set (one absent future target plus five existing pinned targets) and the package itself is the sole current write-set.\n\nExpected FAIL: the separate external consumer intentionally references private identifiers; successful compilation would demonstrate a visibility defect.","textSignature":"{\"v\":1,\"id\":\"msg_086e788cb8bf6932016ace525420b88191ad90ba82a819b21d\",\"phase\":\"commentary\"}"},{"type":"toolCall","id":"call_kw9iheitB9G0sMASW66pm0XL|fc_086e788cb8bf6932016ace52568708819195a61979640f1f53","name":"bash","arguments":{"command":"set -euo pipefail\nROOT=/private/tmp/adr0011-incoming-calls-v1-6yiY4m\nH=$(mktemp -d /tmp/adr0011-v3-independent-harness.XXXXXX)\npython3 - \"$ROOT\" \"$H\" <<'PY'\nimport pathlib, shutil, sys\nroot=pathlib.Path(sys.argv[1]); h=pathlib.Path(sys.argv[2]); p=root/'docs/qualification/adr0011-directional-raw-custody-32mib-private-interface-go-v3'\n(h/'sessionruntime').mkdir(parents=True); (h/'internal/lspwire').mkdir(parents=True); (h/'externalcheck').mkdir(parents=True)\nshutil.copyfile(p/'sessionruntime_private.go.txt',h/'sessionruntime/call_hierarchy_directional_raw_v1_private.go')\nshutil.copyfile(p/'lspwire_private.go.txt',h/'internal/lspwire/read_frame.go')\n(h/'go.mod').write_text('module example.invalid/adr0011-v3-independent\\n\\ngo 1.26\\n')\n(h/'externalcheck/private_visibility_test.go').write_text('package externalcheck\\n\\nimport (\\n sr \"example.invalid/adr0011-v3-independent/sessionruntime\"\\n lw \"example.invalid/adr0011-v3-independent/internal/lspwire\"\\n)\\n\\nvar _ = sr.privateCallHierarchyDirectionV1(0)\\nvar _ = lw.privateDirectionalRawMaxBytesV3\\n')\nprint(h)\nPY\nfind \"$H\" -type f -print0