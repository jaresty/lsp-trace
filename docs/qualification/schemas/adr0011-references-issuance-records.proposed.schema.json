{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/schemas/adr0011-references-issuance-records.proposed.schema.json",
  "title": "PROPOSED ONLY: ADR0011 private references issuance records",
  "oneOf": [
    {"$ref": "#/$defs/proposal"}, {"$ref": "#/$defs/candidate"},
    {"$ref": "#/$defs/final"}, {"$ref": "#/$defs/events"}
  ],
  "$defs": {
    "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "id": {"$ref":"#/$defs/digest"},
    "count": {"type":"integer","minimum":0,"maximum":1000},
    "ref": {"type":"object","additionalProperties":false,"required":["selector","digest","schema_version"],"properties":{
      "selector":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9._/-]*$","not":{"pattern":"(^|/)\\.\\.?(/|$)"}},
      "digest":{"$ref":"#/$defs/digest"},"schema_version":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Z][A-Z0-9_]*_V[1-9][0-9]*$"}
    }},
    "methodRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_METHOD_V1"}}}]},
    "targetRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_TARGET_V1"}}}]},
    "sourceRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_SOURCE_IDENTITY_V1"}}}]},
    "revisionRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_REVISION_IDENTITY_V1"}}}]},
    "policyRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_POLICY_V1"}}}]},
    "rawRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_RAW_RESULT_V1"}}}]},
    "scannerRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_SCANNER_OBSERVATION_V1"}}}]},
    "eventsRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_EVALUATOR_EVENTS_V1"}}}]},
    "proposalRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_EVALUATION_PROPOSAL_V1"}}}]},
    "candidateRef": {"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"schema_version":{"const":"REFERENCES_OCCURRENCE_CANDIDATE_V1"}}}]},
    "context":{"type":"object","additionalProperties":false,"required":["transaction_id","query_occurrence_id","method_ref","target_ref","source_identity_ref","revision_identity_ref","method_policy_ref","admission_policy_ref","privacy_policy_ref","retention_policy_ref","implementation_digest","schema_digests","session_id","generation","request_key","invocation_id"],"properties":{
      "transaction_id":{"$ref":"#/$defs/id"},"query_occurrence_id":{"$ref":"#/$defs/id"},
      "method_ref":{"$ref":"#/$defs/methodRef"},"target_ref":{"$ref":"#/$defs/targetRef"},
      "source_identity_ref":{"$ref":"#/$defs/sourceRef"},"revision_identity_ref":{"$ref":"#/$defs/revisionRef"},
      "method_policy_ref":{"$ref":"#/$defs/policyRef"},"admission_policy_ref":{"$ref":"#/$defs/policyRef"},"privacy_policy_ref":{"$ref":"#/$defs/policyRef"},"retention_policy_ref":{"$ref":"#/$defs/policyRef"},
      "implementation_digest":{"$ref":"#/$defs/digest"},
      "schema_digests":{"type":"array","minItems":4,"maxItems":32,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["role","digest"],"properties":{"role":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"digest":{"$ref":"#/$defs/digest"}}}},
      "session_id":{"type":"string","minLength":1,"maxLength":256},"generation":{"type":"integer","minimum":1},"request_key":{"type":"string","minLength":1,"maxLength":256},"invocation_id":{"type":"string","minLength":1,"maxLength":256}
    }},
    "position":{"type":"object","additionalProperties":false,"required":["line","character"],"properties":{"line":{"type":"integer","minimum":0},"character":{"type":"integer","minimum":0}}},
    "range":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"$ref":"#/$defs/position"},"end":{"$ref":"#/$defs/position"}}},
    "occurrence":{"type":"object","additionalProperties":false,"required":["ordinal","returned_uri","returned_range","occurrence_id"],"properties":{"ordinal":{"$ref":"#/$defs/count"},"returned_uri":{"type":"string","format":"uri","minLength":1},"returned_range":{"$ref":"#/$defs/range"},"occurrence_id":{"$ref":"#/$defs/id"}}},
    "proposal":{"type":"object","additionalProperties":false,"required":["schema_version","context","raw_result_ref","raw_result_presence","raw_result_digest","raw_result_byte_length","scanner_observation_ref","top_level_form","declared_n","evaluator_event_ref","observed_b","known_e","observed_e_b","observed_e_t","whole_result_p","proposed_outcome","proposed_disposition"],"properties":{
      "schema_version":{"const":"REFERENCES_EVALUATION_PROPOSAL_V1"},"context":{"$ref":"#/$defs/context"},"raw_result_ref":{"$ref":"#/$defs/rawRef"},"raw_result_presence":{"const":"PRESENT"},"raw_result_digest":{"$ref":"#/$defs/digest"},"raw_result_byte_length":{"type":"integer","minimum":1,"maximum":1048576},"scanner_observation_ref":{"$ref":"#/$defs/scannerRef"},"top_level_form":{"enum":["NULL","ARRAY"]},"declared_n":{"const":1},"evaluator_event_ref":{"$ref":"#/$defs/eventsRef"},"observed_b":{"const":1},"known_e":{"$ref":"#/$defs/count"},"observed_e_b":{"$ref":"#/$defs/count"},"observed_e_t":{"$ref":"#/$defs/count"},"whole_result_p":{"$ref":"#/$defs/count"},"proposed_outcome":{"enum":["COMPLETE","COMPLETE_EMPTY"]},"proposed_disposition":{"enum":["ITEMS","EMPTY"]}
    },"allOf":[{"if":{"properties":{"proposed_outcome":{"const":"COMPLETE"}}},"then":{"properties":{"proposed_disposition":{"const":"ITEMS"},"whole_result_p":{"minimum":1},"top_level_form":{"const":"ARRAY"}}},"else":{"properties":{"proposed_disposition":{"const":"EMPTY"},"whole_result_p":{"const":0}}}},{"if":{"properties":{"top_level_form":{"const":"NULL"}}},"then":{"properties":{"known_e":{"const":0},"observed_e_b":{"const":0},"observed_e_t":{"const":0},"whole_result_p":{"const":0}}}}]},
    "candidate":{"type":"object","additionalProperties":false,"required":["schema_version","context","proposal_ref","occurrences","proposed_p"],"properties":{"schema_version":{"const":"REFERENCES_OCCURRENCE_CANDIDATE_V1"},"context":{"$ref":"#/$defs/context"},"proposal_ref":{"$ref":"#/$defs/proposalRef"},"occurrences":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/occurrence"}},"proposed_p":{"$ref":"#/$defs/count"}}},
    "final":{"type":"object","additionalProperties":false,"required":["schema_version","context","proposal_ref","candidate_ref","issued_outcome","issued_disposition","n","b","t","e","e_b","e_t","p","a","dependency_refs"],"properties":{
      "schema_version":{"const":"REFERENCES_FINAL_ISSUANCE_V1"},"context":{"$ref":"#/$defs/context"},"proposal_ref":{"$ref":"#/$defs/proposalRef"},"candidate_ref":{"$ref":"#/$defs/candidateRef"},"issued_outcome":{"enum":["COMPLETE","COMPLETE_EMPTY"]},"issued_disposition":{"enum":["ITEMS","EMPTY"]},"n":{"const":1},"b":{"const":1},"t":{"const":1},"e":{"$ref":"#/$defs/count"},"e_b":{"$ref":"#/$defs/count"},"e_t":{"$ref":"#/$defs/count"},"p":{"$ref":"#/$defs/count"},"a":{"$ref":"#/$defs/count"},"dependency_refs":{"type":"array","minItems":8,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}}
    },"allOf":[{"if":{"properties":{"issued_outcome":{"const":"COMPLETE"}}},"then":{"properties":{"issued_disposition":{"const":"ITEMS"},"p":{"minimum":1},"a":{"minimum":1}}},"else":{"properties":{"issued_disposition":{"const":"EMPTY"},"p":{"const":0},"a":{"const":0},"e":{"const":0},"e_b":{"const":0},"e_t":{"const":0}}}}]},
    "event":{"type":"object","additionalProperties":false,"required":["sequence","kind","ordinal","terminal_disposition"],"properties":{"sequence":{"type":"integer","minimum":0,"maximum":2002},"kind":{"enum":["QUERY_BEGIN","ELEMENT_BEGIN","ELEMENT_TERMINAL","QUERY_TERMINAL"]},"ordinal":{"anyOf":[{"$ref":"#/$defs/count"},{"type":"null"}]},"terminal_disposition":{"enum":["NONE","VALID_PENDING_ADMISSION","ITEMS","EMPTY"]}},"allOf":[{"if":{"properties":{"kind":{"const":"QUERY_BEGIN"}}},"then":{"properties":{"ordinal":{"type":"null"},"terminal_disposition":{"const":"NONE"}}}},{"if":{"properties":{"kind":{"const":"ELEMENT_BEGIN"}}},"then":{"properties":{"ordinal":{"type":"integer"},"terminal_disposition":{"const":"NONE"}}}},{"if":{"properties":{"kind":{"const":"ELEMENT_TERMINAL"}}},"then":{"properties":{"ordinal":{"type":"integer"},"terminal_disposition":{"const":"VALID_PENDING_ADMISSION"}}}},{"if":{"properties":{"kind":{"const":"QUERY_TERMINAL"}}},"then":{"properties":{"ordinal":{"type":"null"},"terminal_disposition":{"enum":["ITEMS","EMPTY"]}}}}]},
    "events":{"type":"object","additionalProperties":false,"required":["schema_version","transaction_id","request_key","invocation_id","response_read_ref","events"],"properties":{"schema_version":{"const":"REFERENCES_EVALUATOR_EVENTS_V1"},"transaction_id":{"$ref":"#/$defs/id"},"request_key":{"type":"string","minLength":1,"maxLength":256},"invocation_id":{"type":"string","minLength":1,"maxLength":256},"response_read_ref":{"$ref":"#/$defs/rawRef"},"events":{"type":"array","minItems":2,"maxItems":2002,"prefixItems":[{"allOf":[{"$ref":"#/$defs/event"},{"properties":{"sequence":{"const":0},"kind":{"const":"QUERY_BEGIN"}}}]}],"items":{"$ref":"#/$defs/event"},"contains":{"properties":{"kind":{"const":"QUERY_TERMINAL"}},"required":["kind"]},"minContains":1,"maxContains":1}}
    }
  }
}
