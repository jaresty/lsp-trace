{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/schemas/lsp-trace.provider-observations.v1.schema.json",
  "title": "Provider-reported observations envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "protocol", "adapter", "authority", "coverage", "documents", "observations"],
  "properties": {
    "provider": {"$ref": "#/$defs/identity"},
    "protocol": {"const": {"name": "lsp-trace.provider-observations", "version": "1"}},
    "adapter": {"$ref": "#/$defs/identity"},
    "authority": {"const": "PROVIDER_REPORTED"},
    "coverage": {"type": "object"},
    "failure": {"type": "string"},
    "diagnostics": {"type": "array", "items": {"type": "object", "required": ["phase", "message"], "additionalProperties": false, "properties": {"phase": {"type": "string"}, "message": {"type": "string"}, "method": {"type": "string"}, "node_id": {"type": "string"}, "category": {"enum": ["UNRESOLVED_CALL", "DYNAMIC_CALL"]}}}},
    "documents": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "from", "to", "original_anchor", "supports", "does_not_support"],
        "properties": {
          "kind": {"enum": ["BINDS_ARGUMENT", "PASSES_CALLBACK", "INVOKES_TASK", "TRIGGERS_RELOAD", "UPDATES_STATE", "RENDERS_FROM"]},
          "from": {"type": "object"},
          "to": {"type": "object"},
          "original_anchor": {"$ref": "#/$defs/anchor"},
          "virtual_anchor": {"$ref": "#/$defs/anchor"},
          "supports": {"type": "array"},
          "does_not_support": {"type": "array"}
        }
      }
    },
    "request_id": {"type": "string"},
    "timestamp": {"type": "string"},
    "source": {"type": "string"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "uri", "revision", "blob", "range"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "blob": {"type": "string", "minLength": 1},
        "mapping_id": {"type": "string"},
        "range": {"type": "object"}
      }
    }
  }
}
