{"isSidechain":true,"agentId":"a856f367-42c9-454","type":"toolResult","message":{"role":"toolResult","toolCallId":"call_00b21dff9abe4e44b11eb679dac33940|fc_086e788cb8bf6932016ace51e05acc8191a97772fb5472944a","toolName":"read","content":[{"type":"text","text":"package lspwire\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"io\"\n)\n\nconst privateDirectionalRawMaxBytesV3 uint64 = 32 << 20\n\ntype privateDirectionalRawLeaseSourceV3 interface {\n\tReserveDirectionalRawV3(component uint8, bytes uint64) (privateDirectionalRawLeaseV3, error)\n}\ntype privateDirectionalRawLeaseV3 struct {\n\tID       uint64\n\tCapacity uint64\n\tActive   bool\n}\ntype privateDirectionalRawOwnedFrameV3 struct {\n\tBytes    []byte\n\tCapacity uint64\n\tSHA256   [sha256.Size]byte\n\tLease    privateDirectionalRawLeaseV3\n\tComplete bool\n\tPresent  bool\n\tErr      error\n}\ntype Reader struct{ R io.Reader }\n\nfunc (r *Reader) readDirectionalRawOwnedFrameV3(ctx context.Context, source privateDirectionalRawLeaseSourceV3, component uint8, limit uint64) (privateDirectionalRawOwnedFrameV3, error) {\n\treturn privateDirectionalRawOwnedFrameV3{}, nil\n}\n\nfunc compileDirectionalRawOwnedFrameV3(r *Reader, ctx context.Context, source privateDirectionalRawLeaseSourceV3) {\n\tframe, err := r.readDirectionalRawOwnedFrameV3(ctx, source, 1, privateDirectionalRawMaxBytesV3)\n\t_, _ = frame, err\n\tframe, err = r.readDirectionalRawOwnedFrameV3(ctx, source, 1, privateDirectionalRawMaxBytesV3+1)\n\t_, _ = frame, err\n\tframe, err = r.readDirectionalRawOwnedFrameV3(ctx, nil, 0, 0)\n\t_, _ = frame, err\n}\n"}],"isError":false,"timestamp":1791906272856},"timestamp":"2026-10-13T15:44:32.856Z","cwd":"/Users/schwa/dev/lsp-trace"}
{"isSidechain":true,"agentId":"a856f367-42c9-454","type":"toolResult","message":{"role":"toolResult","toolCallId":"call_5b05ce52a15b4be9a6cceaaa1ec84e19|fc_086e788cb8bf6932016ace51e05acc81918f7f9d8e40d193c7","toolName":"read","content":[{"type":"text","text":"package sessionruntime\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/binary\"\n\t\"errors\"\n\t\"sync\"\n)\n\nconst (\n\tprivateCallsLSPIncomingExactV1                         = \"CALLS_LSP_INCOMING_EXACT_V1\"\n\tprivateCallsLSPOutgoingExactV1                         = \"CALLS_LSP_OUTGOING_EXACT_V1\"\n\tprivateCallsLSPIncomingDomainV1                        = \"lsp-trace.adr0011.calls.lsp.incoming.exact.v1\"\n\tprivateCallsLSPOutgoingDomainV1                        = \"lsp-trace.adr0011.calls.lsp.outgoing.exact.v1\"\n\tprivateCallsLSPProfileDigestDomainV1                   = \"lsp-trace.adr0011.calls.profile-identity.digest.v1\\x00\"\n\tprivateCallHierarchyDirectionalMaxBytesV3       uint64 = 32 << 20\n\tprivateCallHierarchyDirectionalComponentCountV3        = 6\n)\n\nconst (\n\tprivateStageAReservePrepareFrameV3             = \"299523ae8df6878b9e9100746c96dbaa22ab11e437c3629e4ecac8f277a2bd8e\"\n\tprivateStageACopyPrepareFrameV3                = \"51590290aea507a4972547c0923647c52d1c657fdecdfbb3aa6244ba5a417347\"\n\tprivateStageAAliasPrepareFrameV3               = \"055df35ed225ff329f21bd094f0c1f2c172848bb7c2ff772a93c8fbd6386521b\"\n\tprivateStageAReservePrepareResultV3            = \"2087074f6c253c7566e94420b67919d0f1cf032a01cdd79ca73345159fc38506\"\n\tprivateStageACopyPrepareResultV3               = \"ddbbfd7184803b94919684bb5762ef16309986b1d5b091d650c1e05a9b578779\"\n\tprivateStageAAliasPrepareResultV3              = \"7069d8601cb76101ee1a2c7886f223d0a6119e74b76891d3dd49f35117cb0736\"\n\tprivateStageAReserveSelectedHandoffV3          = \"480446a4372c7fb04f694840320ffdf3ee29da89e9c4e6423ac261916068ca5b\"\n\tprivateStageACopySelectedHandoffV3             = \"2c914f9c29b62ddd6c32e2dc7a2e6008ece26d7c1bca3f26e2c