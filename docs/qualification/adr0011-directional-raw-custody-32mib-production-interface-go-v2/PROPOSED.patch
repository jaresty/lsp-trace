+++ b/sessionruntime/call_hierarchy_directional_raw_v1_private.go
@@ -0,0 +1,328 @@
+package sessionruntime
+
+import (
+	"lsp-trace/internal/session"
+	"math"
+)
+
+const (
+	privateCallHierarchyDirectionalMaxBytesV1 uint64 = 32 << 20
+	privateCallHierarchyCombinedMaxBytesV1    uint64 = 64 << 20
+)
+
+type privateB4PartitionIDV1 uint8
+
+const (
+	privateB4PartitionGeneralC15V2 privateB4PartitionIDV1 = iota + 1
+	privateB4PartitionDirectionalRawV1
+)
+
+type privateB4DirectionalPartitionV1 struct {
+	live       uint64
+	cumulative uint64
+	generation uint64
+	holder     uint64
+	occupied   bool
+}
+
+type privateB4DirectionalLeaseV1 struct {
+	account    *privateB4ByteAccountV2
+	partition  privateB4PartitionIDV1
+	generation uint64
+	holder     uint64
+	capacity   uint64
+	active     bool
+}
+
+type privateCallHierarchyDirectionalLedgerV1 struct {
+	account  *privateB4ByteAccountV2
+	attempts map[privateCallHierarchyDirectionalAttemptIDV1]*privateCallHierarchyDirectionalAttemptV1
+	sequence uint64
+}
+type privateCallHierarchyDirectionalAttemptIDV1 struct{ Sequence uint64 }
+type privateCallHierarchyDirectionalAttemptV1 struct {
+	account  *privateB4ByteAccountV2
+	leases   []privateB4DirectionalLeaseV1
+	terminal bool
+}
+type privateCallHierarchyDirectionalTerminalV1 struct {
+	attempt *privateCallHierarchyDirectionalAttemptV1
+}
+
+func (a *privateB4ByteAccountV2) reserveDirectionalV1(capacity uint64) (privateB4DirectionalLeaseV1, session.Failure) {
+	if a == nil || capacity == 0 {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	d := &a.directional
+	general := a.table.general.live
+	if a.terminalRequested || a.backingReleased || d.occupied || d.generation == math.MaxUint64 {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	if capacity > privateCallHierarchyDirectionalMaxBytesV1 {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	if general > privateB4MaxOwnedBytes || general > math.MaxUint64-capacity || general+capacity > privateCallHierarchyCombinedMaxBytesV1 {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	if d.cumulative > math.MaxUint64-capacity {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	d.generation++
+	d.holder = d.generation
+	d.live = capacity
+	d.cumulative += capacity
+	d.occupied = true
+	return privateB4DirectionalLeaseV1{account: a, partition: privateB4PartitionDirectionalRawV1, generation: d.generation, holder: d.holder, capacity: capacity, active: true}, ""
+}
+func (l privateB4DirectionalLeaseV1) alias() privateB4DirectionalLeaseV1 {
+	if l.account == nil || l.partition != privateB4PartitionDirectionalRawV1 || !l.active {
+		return privateB4DirectionalLeaseV1{}
+	}
+	l.account.mu.Lock()
+	defer l.account.mu.Unlock()
+	d := &l.account.directional
+	if !d.occupied || d.generation != l.generation || d.holder != l.holder || d.live != l.capacity {
+		return privateB4DirectionalLeaseV1{}
+	}
+	return l
+}
+func transferDirectionalV1(source *privateB4DirectionalLeaseV1, destination privateB4PartitionIDV1) (privateB4DirectionalLeaseV1, session.Failure) {
+	if source == nil || source.account == nil || source.partition != privateB4PartitionDirectionalRawV1 || destination != source.partition || !source.active {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	a := source.account
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	d := &a.directional
+	if !d.occupied || d.generation != source.generation || d.holder != source.holder || d.live != source.capacity || d.holder == math.MaxUint64 {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	d.holder++
+	out := *source
+	out.holder = d.holder
+	source.active = false
+	return out, ""
+}
+func (l *privateB4DirectionalLeaseV1) release() bool {
+	if l == nil || l.account == nil || l.partition != privateB4PartitionDirectionalRawV1 || !l.active {
+		return false
+	}
+	a := l.account
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	d := &a.directional
+	if !d.occupied || d.generation != l.generation || d.holder != l.holder || d.live != l.capacity {
+		l.active = false
+		return false
+	}
+	d.live = 0
+	d.occupied = false
+	l.active = false
+	return true
+}
+func releaseDirectionalGenerationV1(l *privateB4DirectionalLeaseV1) bool {
+	if l == nil || l.account == nil || l.partition != privateB4PartitionDirectionalRawV1 {
+		return false
+	}
+	a := l.account
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	d := &a.directional
+	if !d.occupied || d.generation != l.generation || d.live != l.capacity {
+		l.active = false
+		return false
+	}
+	d.live = 0
+	d.occupied = false
+	l.active = false
+	return true
+}
+func (t *privateCallHierarchyDirectionalTerminalV1) releaseLocked() {
+	if t == nil || t.attempt == nil || t.attempt.terminal {
+		return
+	}
+	t.attempt.terminal = true
+	for i := range t.attempt.leases {
+		releaseDirectionalGenerationV1(&t.attempt.leases[i])
+		t.attempt.leases[i] = privateB4DirectionalLeaseV1{}
+	}
+	t.attempt.leases = nil
+}
+func (m *Manager) newDirectionalTerminalV1Locked() *privateCallHierarchyDirectionalTerminalV1 {
+	ledger := &m.directionalRawV1
+	for id, attempt := range ledger.attempts {
+		if attempt.terminal {
+			delete(ledger.attempts, id)
+		}
+	}
+	ledger.sequence++
+	attempt := &privateCallHierarchyDirectionalAttemptV1{account: ledger.account}
+	ledger.attempts[privateCallHierarchyDirectionalAttemptIDV1{Sequence: ledger.sequence}] = attempt
+	return &privateCallHierarchyDirectionalTerminalV1{attempt: attempt}
+}
+func reserveDirectionalComponentV1(a *privateCallHierarchyDirectionalAttemptV1, n uint64) (privateB4DirectionalLeaseV1, session.Failure) {
+	if a == nil || a.account == nil || a.terminal || len(a.leases) != 0 {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	lease, failure := a.account.reserveDirectionalV1(n)
+	if failure == "" {
+		a.leases = append(a.leases, lease)
+	}
+	return lease, failure
+}
+func copyDirectionalComponentV1(l privateB4DirectionalLeaseV1, source []byte) ([]byte, privateB4DirectionalLeaseV1, session.Failure) {
+	if uint64(len(source)) > l.capacity || !l.alias().active {
+		return nil, privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	return append([]byte(nil), source...), l, ""
+}
+func aliasDirectionalComponentV1(l privateB4DirectionalLeaseV1) (privateB4DirectionalLeaseV1, session.Failure) {
+	a := l.alias()
+	if !a.active {
+		return privateB4DirectionalLeaseV1{}, session.ResourceExhausted
+	}
+	return a, ""
+}
+func releaseDirectionalTerminalCoreV1(l *privateB4DirectionalLeaseV1) bool { return l.release() }
