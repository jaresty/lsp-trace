PLANNED_OBLIGATIONS.tsv'\nrows=list(csv.DictReader(tsv.open(),delimiter='\\t'))\ngo=(pkg/'sessionruntime_private.go.txt').read_text(); lines=go.splitlines()\nconst_re=re.compile(r'^const\\s+(privateStageA\\w+)\\s*=\\s*\"([0-9a-f]{64})\"$')\nfunc_re=re.compile(r'^func\\s+\\(m \\*Manager\\)\\s+(\\w+)\\(')\nactual={}; names=[]; adjacency=[]\nfor i,line in enumerate(lines):\n m=const_re.match(line)\n if not m: continue\n j=i+1\n while j<len(lines) and not lines[j].strip(): j+=1\n f=func_re.match(lines[j]) if j<len(lines) else None\n actual[m.group(2)]=f.group(1) if f else None; names.append(m.group(1)); adjacency.append((i+1,j+1))\nexpected={r['stage_a_row_id']:r['proposed_symbol'] for r in rows}\ncanonical=go[go.index('func compilePlannedV3('):go.index('func compileAllPlannedV3(')]\ndefs=func_re.findall(go)\nprint('TSV_ROWS',len(rows),'TSV_IDS',len(expected),'TSV_SYMBOLS',len(set(expected.values())))\nprint('DECL_IDS',len(actual),'DECL_CONST_NAMES',len(set(names)))\nprint('MAP_EQUAL',actual==expected,'EXTRAS',sorted(set(actual)-set(expected)),'MISSING',sorted(set(expected)-set(actual)))\nprint('ADJACENCY_GAPS',sorted(j-i for i,j in adjacency))\nprint('BAD_DEF_COUNTS',[(s,defs.count(s)) for s in expected.values() if defs.count(s)!=1])\nprint('MISSING_CANONICAL_REFS',[s for s in expected.values() if not re.search(r'\\b'+re.escape(s)+r'\\s*\\(',canonical)])\nprint('CONST_TOTAL_REFS_BAD',[(n,len(re.findall(r'\\b'+re.escape(n)+r'\\b',go))) for n in names if len(re.findall(r'\\b'+re.escape(n)+r'\\b',go))<1])\nPY","timeout":60}},{"type":"toolCall","id":"call_ThplDH509JvFoQiWCtIpsDXk|fc_086e788cb8bf6932016ace554123388191ac4a68f05c089906","name":"bash","arguments":{"command":"git -C /private/tmp/adr0011-incoming-calls-v1-6yiY4m diff --check && git -C /private/tmp/adr0011-incoming-calls-v1-6yiY4m diff --cached --check && git -C /private/tmp/adr0011-incoming-calls-v1-6yiY4m status --porcelain=v1 --untracked-files=all","timeout":30}}],"api":"openai-codex-responses","provider":"ope