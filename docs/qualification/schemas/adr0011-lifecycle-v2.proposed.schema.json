    "common":{"type":"object","required":["role","version","record_id","root_identity","epoch"],"properties":{"role":{"type":"string"},"version":{"const":2},"record_id":{"$ref":"#/$defs/digest"},"root_identity":{"$ref":"#/$defs/identity"},"epoch":{"type":"integer","minimum":1,"maximum":9007199254740991}}},
