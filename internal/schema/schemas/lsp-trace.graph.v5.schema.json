{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/schemas/lsp-trace.graph.v5.schema.json",
  "title": "lsp-trace graph v5 exact sibling correspondence",
  "type": "object",
  "required": ["schema_version", "tool", "invocation", "identity", "sensitivity_policy", "process_context", "evidence_semantics", "seed_memberships", "replay_input_manifest", "portable_locators", "capabilities", "capability_quality", "targets", "nodes", "edges", "terminals", "frontier", "diagnostics", "summary", "trace_receipt"],
  "properties": {
    "schema_version": {"const": "lsp-trace.graph.v5"},
    "execution_bundle_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tool": {"type": "object"},
    "invocation": {"$ref": "#/$defs/invocation"},
    "identity": {"$ref": "#/$defs/identity"},
    "sensitivity_policy": {"type": "object"},
    "process_context": {"type": "object", "required": ["environment", "effective_environment_process_context_digest", "effective_environment_variable_count", "working_directory_process_context_digest", "ambient_environment_state", "redaction"]},
    "evidence_semantics": {"type": "object"}, "evidence_receipt": {"type": "object"},
    "seed_memberships": {"type": ["array", "null"]}, "replay_input_manifest": {"type": "object"}, "portable_locators": {"type": ["array", "null"], "items": {"$ref": "#/$defs/portableLocator"}},
    "capabilities": {"type": "object"}, "capability_quality": {"type": "object"}, "targets": {"type": ["array", "null"]}, "nodes": {"type": ["array", "null"]}, "edges": {"type": ["array", "null"]},
    "terminals": {"type": ["array", "null"]}, "frontier": {"type": ["array", "null"]}, "diagnostics": {"type": ["array", "null"]}, "sibling_candidates": {"type": ["array", "null"], "items": {"type": "object", "required": ["relation_id", "execution_bundle_id", "seed_uri", "seed_label", "origin", "candidate", "direction", "kind", "seed_identity", "provider_evidence_refs", "lsp_evidence_refs", "source_digests", "custody"], "properties": {"relation_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "execution_bundle_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "seed_uri": {"type": "string", "minLength": 1}, "seed_label": {"type": "string", "minLength": 1}, "origin": {"type": "object"}, "document_symbol": {"type": "object"}, "candidate": {"type": "object"}, "direction": {"const": "SIBLING"}, "kind": {"const": "TOPMOST_SIBLING"}, "seed_identity": {"type": "string", "minLength": 1}, "provider_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "lsp_evidence_refs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "source_digests": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "custody": {"$ref": "#/$defs/sourceCustodyEvidence"}}, "additionalProperties": false}}, "dispatch_relationships": {"type": ["array", "null"]}, "seeds": {"type": ["array", "null"]},
    "summary": {"type": "object"}, "trace_receipt": {"type": "object", "required": ["receipt_version", "semantic_commitment_digest", "digest_scope"], "properties": {"receipt_version": {"const": "lsp-trace.semantic-receipt.v5"}, "semantic_commitment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "digest_scope": {"const": "CANONICAL_GRAPH_V5_WITH_EXACT_SIBLING_CORRESPONDENCE_WITHOUT_RECEIPT"}}, "additionalProperties": false},
    "slice": {"$ref": "#/$defs/slice"}
  },
  "additionalProperties": false,
  "$defs": {
    "sourceCustodyEvidence": {"type":"object","additionalProperties":false,"required":["class","authenticated_analyzed_source_identity","claim_ceiling"],"properties":{"class":{"enum":["VERIFIED_HOST","CALLER_ASSERTED_LOCAL","LSP_SUPPLIED_UNAUTHENTICATED","RETAINED_BYTE_CONSISTENCY","UNKNOWN","MISSING"]},"source_content_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"host_receipt_id":{"type":"string","minLength":1},"authenticated_analyzed_source_identity":{"const":false},"claim_ceiling":{"const":"NO_AUTHENTICATED_ANALYZED_SOURCE_IDENTITY"}}},
    "invocation": {
      "type": "object",
      "required": ["workspace_uri", "target", "server", "limits", "request_timeout_ms", "concurrency", "language_id", "expansion", "trace", "output_mode", "output_path", "seeds", "provenance"],
      "properties": {
        "workspace_uri": {"type": "string"}, "target": {"type": "object"}, "server": {"type": "object"}, "limits": {"type": "object"},
        "request_timeout_ms": {"type": "integer", "minimum": 0}, "concurrency": {"type": "integer", "minimum": 0}, "language_id": {"type": "string"},
        "expansion": {"type": "object"}, "trace": {"type": "object"}, "output_mode": {"type": "string"}, "output_path": {"type": "string"},
        "seeds": {"type": ["array", "null"]}, "provenance": {"type": "object"}
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["caller_provenance_class", "resolved_seeds", "aggregate_scope"],
      "properties": {"caller_provenance_class": {"type": "string"}, "tool_version_provenance_class": {"const": "CALLER_ASSERTED"}, "server_version_provenance_class": {"const": "CALLER_ASSERTED"}, "resolved_seeds": {"type": ["array", "null"]}, "resolved_seed_contents_digest": {"type": "string"}, "aggregate_scope": {"const": "RESOLVED_SEED_CONTENTS"}},
      "additionalProperties": false
    },
    "portableLocator": {
      "type": "object",
      "required": ["node_id", "locator", "redaction"],
      "properties": {
        "node_id": {"type": "string"},
        "locator": {"type": "string"},
        "provenance": {
          "type": "object",
          "required": ["source", "derivation", "authority", "semantics"],
          "properties": {
            "source": {"type": "object", "required": ["node_id", "selection_range"]},
            "derivation": {"type": "object", "required": ["method", "version"], "properties": {"method": {"const": "CANONICAL_URI_WITH_SELECTION_RANGE"}, "version": {"const": "1"}}},
            "authority": {"type": "object", "required": ["class", "tool"], "properties": {"class": {"const": "TOOL_DERIVED"}, "tool": {"const": "lsp-trace"}}},
            "semantics": {"type": "object", "required": ["establishes_runtime_behavior", "establishes_feature_correspondence"], "properties": {"establishes_runtime_behavior": {"const": false}, "establishes_feature_correspondence": {"const": false}}}
          }
        },
        "redaction": {"type": "object"}
      }
    },
    "sliceLayer": {
      "type": "object",
      "required": ["depth", "node_ids"],
      "properties": {"depth": {"type": "integer", "minimum": 0}, "node_ids": {"type": ["array", "null"], "items": {"type": "string"}}},
      "additionalProperties": false
    },
    "slicePreparationDisposition": {
      "type": "object",
      "required": ["name", "kind", "selection_range", "status", "prepared_item_ids"],
      "properties": {
        "name": {"type": "string"}, "kind": {"type": "integer"}, "selection_range": {"type": "object"},
        "status": {"enum": ["prepared", "not_preparable", "failed"]},
        "prepared_item_ids": {"type": ["array", "null"], "items": {"type": "string"}}, "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "slicePreparationAccounting": {
      "type": "object",
      "required": ["document_symbols", "attempted", "prepared", "not_preparable", "failed"],
      "properties": {
        "document_symbols": {"type": "integer", "minimum": 0}, "attempted": {"type": "integer", "minimum": 0},
        "prepared": {"type": "integer", "minimum": 0}, "not_preparable": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "slicePreparation": {
      "type": "object",
      "required": ["complete", "accounting", "dispositions"],
      "properties": {
        "complete": {"type": "boolean"}, "accounting": {"$ref": "#/$defs/slicePreparationAccounting"},
        "dispositions": {"type": ["array", "null"], "items": {"$ref": "#/$defs/slicePreparationDisposition"}}
      },
      "additionalProperties": false
    },
    "slice": {
      "type": "object",
      "required": ["source_uri", "down_depth", "up_depth", "starting_node_ids", "layers", "frontier_node_ids", "outgoing_relation_ids"],
      "properties": {
        "start_mode": {"enum": ["from_file", "at", "seed_file"]},
        "source_uri": {"type": "string"}, "down_depth": {"type": "integer", "minimum": 0}, "up_depth": {"type": "integer", "minimum": 0},
        "starting_node_ids": {"type": ["array", "null"], "items": {"type": "string"}},
        "layers": {"type": ["array", "null"], "items": {"$ref": "#/$defs/sliceLayer"}},
        "frontier_node_ids": {"type": ["array", "null"], "items": {"type": "string"}},
        "outgoing_terminal_node_ids": {"type": ["array", "null"], "items": {"type": "string"}},
        "upward_start_node_ids": {"type": ["array", "null"], "items": {"type": "string"}},
        "outgoing_relation_ids": {"type": ["array", "null"], "items": {"type": "string"}},
        "traversal_complete": {"type": "boolean"},
        "preparation": {"$ref": "#/$defs/slicePreparation"}
      },
      "additionalProperties": false
    }
  }
}
