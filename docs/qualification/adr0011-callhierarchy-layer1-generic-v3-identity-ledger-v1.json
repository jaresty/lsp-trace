  "assignment_identity": {
    "input_fields_only": [
      "occurrence_address",
      "request_id"
    ],
    "typed_identity_object": "{\"occurrence_address\":<JSON string>,\"request_id\":<exact original JSON value and type>}",
    "canonical_identity_encoding": "json.dumps(typed_identity, ensure_ascii=False, sort_keys=True, separators=(',',':')) + one LF (U+000A), then UTF-8 encode",
    "canonical_identity_bytes_detail": {
      "member_order": [
        "occurrence_address",
        "request_id"
      ],
      "json_string_escaping": "Python 3 json.dumps with ensure_ascii=False",
      "request_id_type_rule": "Preserve the parsed JSON type and value exactly; no stringification or numeric coercion",
      "whitespace": "None inside JSON; append exactly one LF byte 0x0a after the closing brace",
      "text_encoding": "UTF-8 without BOM"
    },
    "ranking": {
      "primary": "Lowercase 64-character ASCII hexadecimal SHA-256 of canonical identity bytes, ascending lexicographic order",
      "tie_break": "occurrence_address Python string ascending lexicographic order; every ledger address is ASCII, so this is byte-for-byte identical to ascending UTF-8 bytes",
      "rank_assignment": "zero-based ranks 0 through 44 are opaque-incoming; ranks 45 through 84 are opaque-outgoing"
    },
    "authoring_only_not_runtime_derivation": true,
    "executable_reproduction_script": "import hashlib\nimport json\n\nledger_path = \"docs/qualification/adr0011-callhierarchy-layer1-generic-v3-identity-ledger-v1.json\"\nwith open(ledger_path, \"r\", encoding=\"utf-8\") as stream:\n    ledger = json.load(stream)\nrecords = ledger[\"records\"]\n\ndef identity_bytes(record):\n    typed_identity = {\n        \"occurrence_address\": record[\"occurrence_address\"],\n        \"request_id\": record[\"request_id\"],\n    }\n    return (\n        json.dumps(\n            typed_identity,\n            ensure_ascii=False,\n            sort_keys=True,\n            separators=(\",\", \":\"),\n        )\n        + \"\\n\"\n    ).encode(\"utf-8\")\n\nranked = sorted(\n    records,\n    key=lambda record: (\n        hashlib.sha256(identity_bytes(record)).hexdigest(),\n        record[\"occurrence_address\"],\n    ),\n)\nreproduced = {\n    record[\"occurrence_address\"]: (\n        \"opaque-incoming\" if rank < 45 else \"opaque-outgoing\"\n    )\n    for rank, record in enumerate(ranked)\n}\nassert len(reproduced) == 85\nassert sum(value == \"opaque-incoming\" for value in reproduced.values()) == 45\nassert sum(value == \"opaque-outgoing\" for value in reproduced.values()) == 40\nassert all(\n    reproduced[record[\"occurrence_address\"]] == record[\"binding_identity\"]\n    for record in records\n)\nprint(json.dumps(reproduced, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")))\n"
