{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/mcp/schemas/input-structural-context.v1.schema.json",
  "title": "FUTURE/PROPOSED operation 35 structural-context input; unregistered until operation 34 lands",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "generation", "uri", "down_depth", "up_depth", "max_nodes", "timeout_ms", "request_timeout_ms", "analysis"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "generation": {"type": "integer", "minimum": 1},
    "uri": {"type": "string", "format": "uri", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 1024},
    "line": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "character": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "down_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "up_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 10000},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "request_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "NEIGHBORHOOD"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "direction", "depth"],
          "properties": {
            "kind": {"const": "IMPACT"},
            "direction": {"enum": ["INCOMING", "OUTGOING"]},
            "depth": {"type": "integer", "minimum": 1, "maximum": 64}
          }
        }
      ]
    }
  },
  "oneOf": [
    {"required": ["symbol"], "not": {"anyOf": [{"required": ["line"]}, {"required": ["character"]}]}},
    {"required": ["line", "character"], "not": {"required": ["symbol"]}}
  ]
}
