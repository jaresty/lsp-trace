{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/schemas/lsp-trace.graph.v4.schema.json",
  "title": "lsp-trace graph v4 normalized relations",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "nodes", "edges", "relations"],
  "properties": {
    "schema_version": {"const": "lsp-trace.graph.v4"},
    "nodes": {"type": ["array", "null"]},
    "edges": {"type": ["array", "null"], "description": "Compatibility projection containing CALLS relations only."},
    "relations": {"type": ["array", "null"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider", "protocol", "adapter", "coverage", "bounds", "custody", "observation_ids", "logical_digest", "receipt"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "provider": {"type": "object"},
        "protocol": {"type": "object"},
        "adapter": {"type": "object"},
        "coverage": {"type": "object"},
        "bounds": {"type": "object"},
        "custody": {"type": "object"},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "logical_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "receipt": {"type": "object"}
      }
    }
  }
}
