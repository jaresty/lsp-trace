te(nil), o.frames.response.frameBytes...)\n591\t\to.result.bytes = append(json.RawMessage(nil), o.result.bytes...)\n592\t\treturn o\n593\t}\n594\tfunc newCallHierarchyLayer1GenericOwner(observation callHierarchyLayer1GenericObservation) *callHierarchyLayer1GenericOwner {\n595\t\to := &callHierarchyLayer1GenericOwner{observation: copyGenericObservation(observation)}\n596\t\to.cond.L = &o.mu\n597\t\treturn o\n598\t}\n599\tfunc (r RoundTripResult) privateCallHierarchyLayer1GenericLease() (any, bool) {\n600\t\to := r.callHierarchyLayer1Generic\n601\t\tif o == nil {\n602\t\t\treturn nil, false\n603\t\t}\n604\t\to.mu.Lock()\n605\t\tok := !o.admissionClosed && !o.released\n606\t\to.mu.Unlock()\n607\t\tif !ok {\n608\t\t\treturn nil, false\n609\t\t}\n610\t\treturn callHierarchyLayer1GenericLease{owner: o}, true\n611\t}\n612\tfunc genericView(o callHierarchyLayer1GenericObservation) callHierarchyLayer1GenericView {\n613\t\tc := copyGenericObservation(o)\n614\t\treturn callHierarchyLayer1GenericView{c.accounting, c.commitments, c.error, c.external, c.frames, c.identity, c.refusalType, c.refusalReason, c.refused, c.result, c.roundTripLedger, c.terminal, c.transport}\n615\t}\n616\tfunc (l callHierarchyLayer1GenericLease) View() (callHierarchyLayer1GenericView, bool) {\n617\t\tif l.owner == nil {\n618\t\t\treturn callHierarchyLayer1GenericView{}, false\n619\t\t}\n620\t\to := l.owner\n621\t\to.mu.Lock()\n622\t\tdefer o.mu.Unlock()\n623\t\tif o.admissionClosed || o.released {\n624\t\t\treturn callHierarchyLayer1GenericView{}, false\n625\t\t}\n626\t\treturn genericView(o.observation), true\n627\t}\n628\tfunc (l callHierarchyLayer1GenericLease) Callback(fn func(callHierarchyLayer1GenericView) error) (err error) {\n629\t\tif l.owner == nil || fn == nil {\n630\t\t\treturn ErrOwnedMethodPairLeaseClosed\n631\t\t}\n632\t\to := l.owner\n633\t\to.mu.Lock()\n634\t\tif o.admissionClosed || o.released {\n635\t\t\to.mu.Unlock()\n636\t\t\treturn ErrOwnedMethodPairLeaseClosed\n637\t\t}\n638\t\to.active++\n639\t\tv := genericView(o.observation)\n640\t\to.mu.Unlock()\n641\t\tdefer func() {\n642\t\t\tif recover() != nil {\n643\t\t\t\terr = errors.New(\"call hierarchy layer1 generic callback panicked\")\n644\t\t\t}\n645\t\t\to.mu.Lock()\n646\t\t\to.active--\n647\t\t\tif o.active == 0 {\n648\t\t\t\to.cond.Broadcast()\n649\t\t\t}\n650\t\t\to.mu.Unlock()\n651\t\t}()\n652\t\treturn fn(v)\n653\t}\n654\tfunc (o *callHierarchyLayer1GenericOwner) releaseLocked() bool {\n655\t\tif o.releaseStarted || o.released {\n656\t\t\treturn false\n657\t\t}\n658\t\to.releaseStarted = true\n659\t\to.observation = callHierarchyLayer1GenericObservation{}\n660\t\to.released = true\n661\t\to.cond.Broadcast()\n662\t\treturn true\n663\t}\n664\tfunc (l callHierarchyLayer1GenericLease) Release() bool {\n665\t\tif l.owner == nil {\n666\t\t\treturn false\n667\t\t}\n668\t\to := l.owner\n669\t\to.mu.Lock()\n670\t\to.admissionClosed = true\n671\t\to.cond.Broadcast()\n672\t\tfor o.active != 0 {\n673\t\t\to.cond.Wait()\n674\t\t}\n675\t\twon := o.releaseLocked()\n676\t\to.mu.Unlock()\n677\t\treturn won\n678\t}\n679\tfunc (o *callHierarchyLayer1GenericOwner) requestTerminal() {\n680\t\tif o == nil {\n681\t\t\treturn\n682\t\t}\n683\t\to.mu.Lock()\n684\t\to.admissionClosed = true\n685\t\to.cond.Broadcast()\n686\t\tfor o.active != 0 {\n687\t\t\to.cond.Wait()\n688\t\t}\n689\t\to.releaseLocked()\n690\t\to.mu.Unlock()\n691\t}\n692\tfunc (o *callHierarchyLayer1GenericOwner) waitReleased() {\n693\t\tif o == nil {\n694\t\t\treturn\n695\t\t}\n696\t\to.mu.Lock()\n697\t\tfor !o.released {\n698\t\t\to.cond.Wait()\n699\t\t}\n700\t\to.mu.Unlock()\n701\t}\n702\t\n703\tfunc genericMeasure(value uint64, available bool) callHierarchyMeasure {\n704\t\treturn callHierarchyMeasure{value: value, available: available}\n705\t}\n706\tfunc genericDelta(before, after callHierarchyMeasure) callHierarchyLayer1GenericLedgerDimension {\n707\t\tif !before.available || !after.available || after.value < before.value {\n708\t\t\tretur