{"isSidechain":true,"agentId":"a856f367-42c9-454","type":"toolResult","message":{"role":"toolResult","toolCallId":"call_19f1ff361618486c823fbc27df5b580c|fc_086e788cb8bf6932016ace550750888191a1060d9a4e2bc8bf","toolName":"read","content":[{"type":"text","text":"package sessionruntime\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/binary\"\n\t\"errors\"\n\t\"sync\"\n)\n\nconst (\n\tprivateCallsLSPIncomingExactV1                         = \"CALLS_LSP_INCOMING_EXACT_V1\"\n\tprivateCallsLSPOutgoingExactV1                         = \"CALLS_LSP_OUTGOING_EXACT_V1\"\n\tprivateCallsLSPIncomingDomainV1                        = \"lsp-trace.adr0011.calls.lsp.incoming.exact.v1\"\n\tprivateCallsLSPOutgoingDomainV1                        = \"lsp-trace.adr0011.calls.lsp.outgoing.exact.v1\"\n\tprivateCallsLSPProfileDigestDomainV1                   = \"lsp-trace.adr0011.calls.profile-identity.digest.v1\\x00\"\n\tprivateCallHierarchyDirectionalMaxBytesV3       uint64 = 32 << 20\n\tprivateCallHierarchyDirectionalComponentCountV3        = 6\n)\n\ntype privateCallHierarchyDirectionV1 uint8\n\nconst (\n\tprivateCallHierarchyDirectionInvalidV1 privateCallHierarchyDirectionV1 = iota\n\tprivateCallHierarchyDirectionIncomingV1\n\tprivateCallHierarchyDirectionOutgoingV1\n)\n\ntype privateCallHierarchyDirectionalComponentV3 uint8\n\nconst (\n\tprivateCallHierarchyDirectionalComponentInvalidV3 privateCallHierarchyDirectionalComponentV3 = iota\n\tprivateCallHierarchyDirectionalComponentPrepareFrameV3\n\tprivateCallHierarchyDirectionalComponentPrepareResultV3\n\tprivateCallHierarchyDirectionalComponentSelectedHandoffV3\n\tprivateCallHierarchyDirectionalComponentDirectionalFrameV3\n\tprivateCallHierarchyDirectionalComponentDirectionalResultV3\n\tprivateCallHierarchyDirectionalComponentRetainedExternalEvidenceV3\n)\n\ntype privateCallHierarchyDirectionalOwnershipV3 uint8\n\nconst (\n\tprivateCallHierarchyDirectionalOwnershipInvalidV3 privateCallHierarchyDirectionalOwnershipV3 = iota\n\tprivateCallHierarchyDirectionalOwnershipOwnedV3\n\tprivateCallHierarchyDirectionalOwnershipAliasV3\n)\n\ntype privateCallHierarchyDirectionalStateV3 uint8\n\nconst (\n\tprivateCallHierarchyDirectionalStateUnreservedV3 privateCallHierarchyDirectionalStateV3 = iota\n\tprivateCallHierarchyDirectionalStateReservedV3\n\tprivateCallHierarchyDirectionalStateAcquiredV3\n\tprivateCallHierarchyDirectionalStateTerminalV3\n\tprivateCallHierarchyDirectionalStateReleasedV3\n)\n\ntype privateCallHierarchyStageV3 uint8\n\nconst (\n\tprivateCallHierarchyStageInvalidV3 privateCallHierarchyStageV3 = iota\n\tprivateCallHierarchyStageReservationV3\n\tprivateCallHierarchyStageAcquisitionV3\n\tprivateCallHierarchyStageAliasV3\n\tprivateCallHierarchyStageTransferV3\n\tprivateCallHierarchyStagePublicationV3\n\tprivateCallHierarchyStageTerminalV3\n\tprivateCallHierarchyStageReleaseV3\n)\n\ntype privateCallHierarchyRefusalV3 uint8\n\nconst (\n\tprivateCallHierarchyRefusalNoneV3 privateCallHierarchyRefusalV3 = iota\n\tprivateCallHierarchyRefusalInvalidV3\n\tprivateCallHierarchyRefusalNilV3\n\tprivateCallHierarchyRefusalStaleV3\n\tprivateCallHierarchyRefusalForeignV3\n\tprivateCallHierarchyRefusalTerminalV3\n\tprivateCallHierarchyRefusalDuplicateComponentV3\n\tprivateCallHierarchyRefusalOverflowV3\n\tprivateCallHierarchyRefusalAttemptLimitV3\n\tprivateCallHierarchyRefusalAccountLimitV3\n\tprivateCallHierarchyRefusalLeaseV3\n\tprivateCallHierarchyRefusalAcquireV3\n\tprivateCallHierarchyRefusalPublishV3\n\tprivateCallHierarchyRefusalTerminalRaceV3\n)\n\ntype privateCallHierarchyTerminalV3 uint8\n\nconst (\n\tprivateCallHierarchyTerminalNoneV3 privateCallHierarchyTerminalV3 = iota\n\tprivateCallHierarchyTerminalCompleteV3\n\tprivateCallHierarchyTerminalCompleteEmptyV3\n\tprivateCallHierarchyTerminalMalformedV3\n\tprivateCallHierarchyTerminalProtocolV3\n\tprivateCallHierarchyTerminalTransportV3\n\tprivateCallHierarchyTerminalUnsupportedV3\n\tprivateCallHierarchyTerminalTimeoutV3\n\tprivateCallHierarchyTerminalCancelledV3\n\tprivateCallHierarchyTerminalRefusedV3\n\tprivateCallHierarchyTerminalStopV3\n\tprivateCallHierarchyTerminalRestartV3\n\tprivateCallHierarchyTerminalShutdownV3\n\tprivateCallHierarchyTerminalStaleGenerationV3\n)\n\ntype privateCallHierarchyCompletenessV3 uint8\n\nconst (\n\tprivateCallHierarchyCompletenessUnknownV3 privateCallHierarchyCompletenessV3 = iota\n\tprivateCallHierarchyCompletenessTargetSetCompleteV3\n)\n\ntype privateCallHierarchyDirectionalAttemptIDV3 struct{ Generation, Sequence uint64 }\ntype privateCallHierarchyDirectionalAccountIDV3 uint64\ntype privateCallHierarchyDirectionalLeaseIDV3 uint64\ntype privateCallHierarchyDirectionalTransferIDV3 uint64\ntype privateCallHierarchyDirectionalReleaseIDV3 uint64\n\ntype privateCallHierarchyProfileIdentityV3 struct {\n\tID, Domain string\n\tDigest     [sha256.Size]byte\n}\ntype privateCallHierarchyTargetIdentityV3 struct {\n\tOrdinal                                   uint64\n\tURI                                       string\n\tSelection, SourceCustody, RevisionCustody [sha256.Size]byte\n}\ntype privateCallHierarchyAttemptOutcomeV3 struct {\n\tTargetOrdinal uint64\n\tTerminal      privateCallHierarchyTerminalV3\n\tStage         privateCallHierarchyStageV3\n\tRefusal       privateCallHierarchyRefusalV3\n}\ntype privateCallHierarchyFrontierV3 struct {\n\tPresent             bool\n\tTargetOrdinal       uint64\n\tStage               privateCallHierarchyStageV3\n\tRefusal             privateCallHierarchyRefusalV3\n\tUnattemptedOrdinals []uint64\n}\ntype privateCallHierarchyTargetAccountingV3 struct {\n\tTargetSetID                         [sha256.Size]byte\n\tDenominatorKnown                    bool\n\tDenominator, Attempted, Unattempted uint64\n\tOutcomes                            []privateCallHierarchyAttemptOutcomeV3\n\tFrontier                            privateCallHierarchyFrontierV3\n\tCompleteness                        privateCallHierarchyCompletenessV3\n}\n\ntype privateB4ByteAccountV2 struct{ mu sync.Mutex }\ntype privateB4ByteLeaseV2 struct {\n\tID       uint64\n\tCapacity uint64\n\tActive   bool\n}\ntype callHierarchyLayer1GenericOwner struct{ mu sync.Mutex }\n\ntype privateCallHierarchyDirectionalLeaseV3 struct {\n\tID                  privateCallHierarchyDirectionalLeaseIDV3\n\tAccount             privateCallHierarchyDirectionalAccountIDV3\n\tAttempt             privateCallHierarchyDirectionalAttemptIDV3\n\tComponent           privateCallHierarchyDirectionalComponentV3\n\tCapacity, BackingID uint64\n\tActive              bool\n\tC15                 privateB4ByteLeaseV2\n}\ntype privateCallHierarchyDirectionalAliasV3 struct {\n\tOwnerLease     privateCallHierarchyDirectionalLeaseIDV3\n\tOffset, Length uint64\n\tOwnerRelease   privateCallHierarchyDirectionalReleaseIDV3\n}\ntype privateCallHierarchyDirectionalOwnedSourceV3 struct {\n\tBytes               []byte\n\tCapacity, BackingID uint64\n\tLeases              []privateCallHierarchyDirectionalLeaseV3\n}\ntype privateCallHierarchyDirectionalAliasSourceV3 struct {\n\tOwner          *privateCallHierarchyDirectionalAcquisitionV3\n\tOffset, Length uint64\n}\ntype privateCallHierarchyDirectionalAcquisitionV3 struct {\n\tAccount   privateCallHierarchyDirectionalAccountIDV3\n\tAttempt   privateCallHierarchyDirectionalAttemptIDV3\n\tComponent privateCallHierarchyDirectionalComponentV3\n\tOwnership privateCallHierarchyDirectionalOwnershipV3\n\tBytes     []byte\n\tCapacity  uint64\n\tLeases    []privateCallHierarchyDirectionalLeaseV3\n\tAlias     *privateCallHierarchyDirectionalAliasV3\n\tDigest    [sha256.Size]byte\n\tValid     bool\n}\ntype privateCallHierarchyDirectionalComponentAccountV3 struct {\n\tComponent                privateCallHierarchyDirectionalComponentV3\n\tReservedBytes, LiveBytes uint64\n\tOwnerLease               privateCallHierarchyDirectionalLeaseIDV3\n\tAliasCount               uint64\n}\ntype privateCallHierarchyDirectionalAccountV3 struct {\n\tmu                       sync.Mutex\n\tID                       privateCallHierarchyDirectionalAccountIDV3\n\tAttempt                  privateCallHierarchyDirectionalAttemptIDV3\n\tDirection                privateCallHierarchyDirectionV1\n\tProfile                  privateCallHierarchyProfileIdentityV3\n\tState                    privateCallHierarchyDirectionalStateV3\n\tReservedBytes, LiveBytes uint64\n\tComponents               [privateCallHierarchyDirectionalComponentCountV3]privateCallHierarchyDirectionalComponentAccountV3\n\tTerminal                 privateCallHierarchyTerminalV3\n\tReleaseID                privateCallHierarchyDirectionalReleaseIDV3\n\tC15                      *privateB4ByteAccountV2\n}\ntype privateCallHierarchyDirectionalReservationV3 struct {\n\tAccount   privateCallHierarchyDirectionalAccountIDV3\n\tAttempt   privateCallHierarchyDirectionalAttemptIDV3\n\tComponent privateCallHierarchyDirectionalComponentV3\n\tBytes     uint64\n\tStage     privateCallHierarchyStageV3\n\tRefusal   privateCallHierarchyRefusalV3\n\tAdmitted  bool\n}\ntype privateCallHierarchyDirectionalTransferV3 struct {\n\tID                                privateCallHierarchyDirectionalTransferIDV3\n\tSourceAttempt, DestinationAttempt privateCallHierarchyDirectionalAttemptIDV3\n\tComponent                         privateCallHierarchyDirectionalComponentV3\n}\ntype privateCallHierarchyDirectionalPublicationReceiptV3 struct {\n\tAttempt   privateCallHierarchyDirectionalAttemptIDV3\n\tComponent privateCallHierarchyDirectionalComponentV3\n\tDigest    [sha256.Size]byte\n\tPresent   bool\n}\ntype privateCallHierarchyDirectionalSubledgerV3 struct {\n\tAccounts           map[privateCallHierarchyDirectionalAccountIDV3]*privateCallHierarchyDirectionalAccountV3\n\tNextAccount        uint64\n\tAggregateLiveBytes uint64\n\tRefusalPreeffects  map[privateCallHierarchyRefusalV3]uint64\n}\ntype Manager struct {\n\tmu               sync.Mutex\n\tdirectionalRawV3 privateCallHierarchyDirectionalSubledgerV3\n}\n\nfunc privateCallHierarchy