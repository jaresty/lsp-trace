{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://jaresty.github.io/lsp-trace/schemas/lsp-trace.retained-calls.v1.schema.json",
 "title":"Retained CALLS tables; composed semantic admission required",
 "type":"object","additionalProperties":false,
 "required":["schema_version","input_bytes","input_digest","tables","ceilings"],
 "properties":{
  "schema_version":{"const":"lsp-trace.retained-calls.v1"},
  "input_bytes":{"type":"string","contentEncoding":"base64","maxLength":67108864},
  "input_digest":{"$ref":"#/$defs/digest"},
  "ceilings":{"const":{"analyzed_version":"ANALYZED_VERSION_UNVERIFIED","dependency_completeness":"UNKNOWN_INCOMPLETE","per_callsite_acquisition_method":"UNAVAILABLE","per_callsite_request_id":"UNAVAILABLE","per_callsite_response_id":"UNAVAILABLE","authenticated_provider_version":"UNAVAILABLE","provider_qualification":"UNAVAILABLE","analyzed_source_authentication":"UNAVAILABLE","independent_numeric_support":"UNAVAILABLE","repeated_identical_report_count":"UNAVAILABLE","incoming_request_successes_scope":"BUNDLE_DERIVED_METRIC_NOT_REQUEST_EVIDENCE","supply_method_scope":"DOCUMENT_NOTIFICATION_NOT_CALL_ACQUISITION","coherent_public_forgery":"NOT_INDEPENDENTLY_REAUTHENTICATED"}},
  "tables":{"type":"object","additionalProperties":false,
   "required":["contexts","endpoints","groups","occurrences","node_memberships","bindings","supply","captures","support_total"],
   "properties":{
    "contexts":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","graph_digest","envelope","bundle"],"properties":{"id":{"$ref":"#/$defs/digest"},"graph_digest":{"$ref":"#/$defs/digest"},"envelope":{"type":"object"},"bundle":{"type":"object"}}}},
    "endpoints":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/node"}},"groups":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/group"}},
    "occurrences":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/occurrence"}},
    "node_memberships":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/membership"}},"bindings":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/binding"}},"supply":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sourceReceipt"}]},"captures":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/sourceReceipt"}},"support_total":{"type":"integer","minimum":0,"maximum":50000}
   }
  }
 },
 "$defs":{
  "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
  "position":{"type":"object","additionalProperties":false,"required":["line","character"],"properties":{"line":{"type":"integer","minimum":0,"maximum":4294967295},"character":{"type":"integer","minimum":0,"maximum":4294967295}}},
  "range":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"$ref":"#/$defs/position"},"end":{"$ref":"#/$defs/position"}}},
  "node":{"type":"object","additionalProperties":false,"required":["id","name","kind","uri","range","selection_range"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"kind":{"type":"integer"},"uri":{"type":"string"},"range":{"$ref":"#/$defs/range"},"selection_range":{"$ref":"#/$defs/range"},"detail":{"type":"string"},"data":{}}},
  "membership":{"type":"object","additionalProperties":false,"required":["membership_id","seed_label","seed_at","evidence_kind","endpoint_id"],"properties":{"membership_id":{"$ref":"#/$defs/digest"},"execution_bundle_id":{"type":"string"},"seed_label":{"type":"string"},"seed_at":{"type":"string"},"evidence_kind":{"enum":["CALL_RELATION","PREPARED_TARGET","REACHED_NODE"]},"endpoint_id":{"type":"string"}}},
  "binding":{"type":"object","additionalProperties":false,"required":["pointer","uri","attribution","receipt_ids"],"properties":{"pointer":{"type":"string","pattern":"^/"},"uri":{"type":"string"},"attribution":{"enum":["SOURCE","NON_SOURCE"]},"receipt_ids":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}}}},
  "sourceReceipt":{"type":"object","additionalProperties":false,"required":["id","uri","path","classification","analyzed_version","status","content","canonical_receipt"],"properties":{"id":{"$ref":"#/$defs/digest"},"uri":{"type":"string"},"path":{"type":"string"},"classification":{"enum":["LSP_SUPPLIED","POST_TRAVERSAL_CAPTURE"]},"analyzed_version":{"const":"ANALYZED_VERSION_UNVERIFIED"},"status":{"enum":["READABLE","UNREADABLE","BYTE_LIMIT_EXCEEDED","BUDGET_EXCEEDED","CANCELLED","OUTSIDE_SCOPE","INVALID_URI","VIRTUAL_URI"]},"content":{"type":["string","null"],"contentEncoding":"base64","maxLength":1398104},"canonical_receipt":{"type":"string","contentEncoding":"base64"},"supply":{"type":"object","additionalProperties":false,"required":["session_id","generation","document_version","method","params"],"properties":{"session_id":{"type":"string"},"generation":{"type":"integer","minimum":1},"document_version":{"type":"integer","minimum":1},"method":{"enum":["textDocument/didOpen","textDocument/didChange"]},"params":{"type":"object","description":"Exact full-text notification contract additionally enforced by graph-provenance semantic admission."}}}}},
  "relationReceipt":{"type":"object","additionalProperties":false,"required":["relation_id","relation_kind","evidence_class","evidence_role","direction","locator","source_revision","support_contribution"],"properties":{"relation_id":{"$ref":"#/$defs/digest"},"relation_kind":{"const":"CALL_RELATION"},"evidence_class":{"const":"SERVER_REPORTED_CALL_HIERARCHY"},"evidence_role":{"const":"CALL_SUPPORT"},"direction":{"const":"CALLER_TO_CALLEE"},"locator":{"type":"string"},"source_revision":{"type":"string"},"support_contribution":{"const":1},"seed_uri":{"type":"string"},"seed_label":{"type":"string"},"candidate_node_id":{"type":"string"},"interface_node_id":{"type":"string"},"implementation_node_id":{"type":"string"},"caller_node_id":{"type":"string"},"callee_node_id":{"type":"string"}}},
  "group":{"type":"object","additionalProperties":false,"required":["context_id","relation_id","execution_bundle_id","caller_node_id","callee_node_id","pointer","callsite_state","occurrence_ids","receipt","memberships","outgoing_participation"],"properties":{
   "context_id":{"$ref":"#/$defs/digest"},"relation_id":{"$ref":"#/$defs/digest"},"execution_bundle_id":{"type":"string"},"caller_node_id":{"type":"string"},"callee_node_id":{"type":"string"},"pointer":{"type":"string","pattern":"^/edges/[0-9]+$"},"callsite_state":{"enum":["UNREPORTED","RETAINED_DISTINCT_RANGES"]},"occurrence_ids":{"type":"array","maxItems":50000,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},"receipt":{"$ref":"#/$defs/relationReceipt"},"memberships":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/membership"}},"outgoing_participation":{"type":"boolean"}
  }},
  "occurrence":{"type":"object","additionalProperties":false,"required":["id","context_id","relation_id","caller_node_id","callee_node_id","caller_uri","range","binding"],"properties":{
   "id":{"$ref":"#/$defs/digest"},"context_id":{"$ref":"#/$defs/digest"},"relation_id":{"$ref":"#/$defs/digest"},"caller_node_id":{"type":"string"},"callee_node_id":{"type":"string"},"caller_uri":{"type":"string"},"range":{"$ref":"#/$defs/range"},"binding":{"$ref":"#/$defs/binding"}
  }}
 }
}
