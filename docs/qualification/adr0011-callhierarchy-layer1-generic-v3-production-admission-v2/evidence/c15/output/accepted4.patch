+	o := l.owner
+	o.mu.Lock()
+	if o.admissionClosed || o.released {
+		o.mu.Unlock()
+		return ErrOwnedMethodPairLeaseClosed
+	}
+	o.active++
+	v := genericView(o.observation)
+	o.mu.Unlock()
