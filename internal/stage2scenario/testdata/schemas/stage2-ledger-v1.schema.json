    "census":{"type":"object","additionalProperties":false,"required":["live_sessions","terminal_sessions","generations","lifecycle_ledger_retained","lifecycle_ledger_omitted","lifecycle_ledger_truncated","tombstones_retained","tombstones_evicted","tombstones_consumed","waiters","reservations","intents","callers","manager_requests","lsp_requests","tombstones","fake_children","fake_pipes","fake_goroutines","os_processes_exercised"],"properties":{"live_sessions":{"$ref":"#/$defs/count"},"terminal_sessions":{"$ref":"#/$defs/count"},"generations":{"$ref":"#/$defs/count"},"lifecycle_ledger_retained":{"$ref":"#/$defs/count"},"lifecycle_ledger_omitted":{"$ref":"#/$defs/count"},"lifecycle_ledger_truncated":{"type":"boolean"},"tombstones_retained":{"$ref":"#/$defs/count"},"tombstones_evicted":{"$ref":"#/$defs/count"},"tombstones_consumed":{"$ref":"#/$defs/count"},"waiters":{"$ref":"#/$defs/count"},"reservations":{"$ref":"#/$defs/count"},"intents":{"$ref":"#/$defs/count"},"callers":{"$ref":"#/$defs/count"},"manager_requests":{"$ref":"#/$defs/count"},"lsp_requests":{"$ref":"#/$defs/count"},"tombstones":{"$ref":"#/$defs/count"},"fake_children":{"const":0},"fake_pipes":{"const":0},"fake_goroutines":{"const":0},"os_processes_exercised":{"const":false}}},
    "event_record":{"type":"object","additionalProperties":false,"required":["ledger_version","record_type","event"],"properties":{"ledger_version":{"const":"stage2-ledger-v1"},"record_type":{"const":"event"},"event":{"$ref":"#/$defs/event"}}},
    "mcp_record":{"type":"object","additionalProperties":false,"required":["ledger_version","record_type","mcp_reference_result"],"properties":{"ledger_version":{"const":"stage2-ledger-v1"},"record_type":{"const":"mcp_reference_result"},"mcp_reference_result":{"$ref":"#/$defs/mcp"}}},
    "ownership_record":{"type":"object","additionalProperties":false,"required":["ledger_version","record_type","child_ownership"],"properties":{"ledger_version":{"const":"stage2-ledger-v1"},"record_type":{"const":"child_ownership"},"child_ownership":{"$ref":"#/$defs/ownership"}}},
    "intent_record":{"type":"object","additionalProperties":false,"required":["ledger_version","record_type","lifecycle_intent_history"],"properties":{"ledger_version":{"const":"stage2-ledger-v1"},"record_type":{"const":"lifecycle_intent_history"},"lifecycle_intent_history":{"$ref":"#/$defs/intent"}}},
    "session_record":{"type":"object","additionalProperties":false,"required":["ledger_version","record_type","session_generation_history"],"properties":{"ledger_version":{"const":"stage2-ledger-v1"},"record_type":{"const":"session_generation_history"},"session_generation_history":{"$ref":"#/$defs/session"}}},
    "census_record":{"type":"object","additionalProperties":false,"required":["ledger_version","record_type","final_resource_census"],"properties":{"ledger_version":{"const":"stage2-ledger-v1"},"record_type":{"const":"final_resource_census"},"final_resource_census":{"$ref":"#/$defs/census"}}}
