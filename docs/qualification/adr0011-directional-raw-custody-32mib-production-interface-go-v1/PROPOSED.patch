+package sessionruntime
+
+import "lsp-trace/internal/session"
+
+const privateCallHierarchyDirectionalMaxBytesV1 uint64 = 32 << 20
+
+type privateCallHierarchyDirectionalLedgerV1 struct {
+	account  *privateB4ByteAccountV2
+	attempts map[privateCallHierarchyDirectionalAttemptIDV1]*privateCallHierarchyDirectionalAccountV1
+	sequence uint64
+}
+
+type privateCallHierarchyDirectionalAttemptIDV1 struct{ Sequence uint64 }
+type privateCallHierarchyDirectionalAccountV1 struct {
+	c15      *privateB4ByteAccountV2
+	leases   []privateB4ByteLeaseV2
+	terminal bool
+}
+type privateCallHierarchyDirectionalTerminalV1 struct {
+	account *privateCallHierarchyDirectionalAccountV1
+}
+
+func (t *privateCallHierarchyDirectionalTerminalV1) releaseLocked() {
+	if t == nil || t.account == nil || t.account.terminal {
+		return
+	}
+	t.account.terminal = true
+	for i := range t.account.leases {
+		t.account.leases[i].release()
+		t.account.leases[i] = privateB4ByteLeaseV2{}
+	}
+	t.account.leases = nil
+}
+
+func (m *Manager) newDirectionalTerminalV1Locked() *privateCallHierarchyDirectionalTerminalV1 {
+	l := &m.directionalRawV1
+	if l.attempts == nil {
+		l.attempts = make(map[privateCallHierarchyDirectionalAttemptIDV1]*privateCallHierarchyDirectionalAccountV1)
+	}
+	for id, attempt := range l.attempts {
+		if attempt.terminal {
+			delete(l.attempts, id)
+		}
+	}
+	l.sequence++
+	attempt := &privateCallHierarchyDirectionalAccountV1{c15: l.account}
+	l.attempts[privateCallHierarchyDirectionalAttemptIDV1{Sequence: l.sequence}] = attempt
+	return &privateCallHierarchyDirectionalTerminalV1{account: attempt}
+}
+
+func reserveDirectionalComponentV1(account *privateCallHierarchyDirectionalAccountV1, bytes uint64) (privateB4ByteLeaseV2, session.Failure) {
+	if account == nil || account.c15 == nil || account.terminal || bytes == 0 || bytes > privateCallHierarchyDirectionalMaxBytesV1 {
+		return privateB4ByteLeaseV2{}, session.ResourceExhausted
+	}
+	lease, failure := account.c15.reserve(bytes)
+	if failure == "" {
+		account.leases = append(account.leases, lease)
+	}
+	return lease, failure
+}
+
+func copyDirectionalComponentV1(lease privateB4ByteLeaseV2, source []byte) ([]byte, privateB4ByteLeaseV2, session.Failure) {
+	if lease.account == nil || uint64(len(source)) > privateCallHierarchyDirectionalMaxBytesV1 {
+		return nil, privateB4ByteLeaseV2{}, session.ResourceExhausted
+	}
+	return append([]byte(nil), source...), lease, ""
+}
+
+func aliasDirectionalComponentV1(lease privateB4ByteLeaseV2) (privateB4ByteLeaseV2, session.Failure) {
+	alias := lease.alias()
+	if alias.account == nil {
+		return privateB4ByteLeaseV2{}, session.ResourceExhausted
+	}
+	return alias, ""
+}
+
+func transferDirectionalAcquisitionCoreV1(lease *privateB4ByteLeaseV2) (privateB4ByteLeaseV2, session.Failure) {
+	if lease == nil || lease.account == nil {
+		return privateB4ByteLeaseV2{}, session.ResourceExhausted
+	}
+	out := *lease
+	*lease = privateB4ByteLeaseV2{}
+	return out, ""
+}
+
+func releaseDirectionalTerminalCoreV1(lease *privateB4ByteLeaseV2) bool {
+	if lease == nil || lease.account == nil {
+		return false
+	}
+	lease.release()
+	*lease = privateB4ByteLeaseV2{}
+	return true
+}
