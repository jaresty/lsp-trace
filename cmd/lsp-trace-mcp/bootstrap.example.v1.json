{
  "version": 1,
  "processes": [
    {
      "alias": "project",
      "language_id": "go",
      "profile": {
        "trust_domain": "local-development",
        "workspace": "./workspace",
        "profile": "gopls",
        "environment_reference": "developer"
      },
      "execution": {
        "path": "./bin/gopls",
        "arguments": [],
        "directory": "./workspace"
      }
    },
    {
      "alias": "csharp-project",
      "language_id": "csharp",
      "profile": {
        "trust_domain": "local-development",
        "workspace": "./csharp-workspace",
        "profile": "csharp-ls",
        "environment_reference": "developer"
      },
      "execution": {
        "path": "./bin/csharp-ls",
        "arguments": [
          "--features",
          "razor-support",
          "--solution",
          "Project.sln"
        ],
        "directory": "./csharp-workspace"
      }
    }
  ]
}
