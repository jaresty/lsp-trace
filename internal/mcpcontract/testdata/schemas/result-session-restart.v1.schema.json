{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://jaresty.github.io/lsp-trace/mcp/schemas/result-session-restart.v1.schema.json","type":"object","additionalProperties":false,"required":["state","generation","predecessor_generation","reap_status","current_intent","terminal_history"],"properties":{"state":{"const":"READY"},"generation":{"type":"integer","minimum":2},"predecessor_generation":{"type":"integer","minimum":1},"reap_status":{"const":"REAPED"},"current_intent":{"type":"null"},"terminal_history":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["intent_id","kind","target_generation","successor_generation","outcome","operation_status","terminal_event_seq"],"properties":{"intent_id":{"type":"string","minLength":1,"maxLength":256},"kind":{"const":"RESTART"},"target_generation":{"type":"integer","minimum":1},"successor_generation":{"type":"integer","minimum":2},"outcome":{"const":"COMPLETE"},"operation_status":{"const":"SUCCEEDED"},"terminal_event_seq":{"type":"integer","minimum":1}}}}}}
