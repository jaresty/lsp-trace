(line),source_end_line=str(line),source_sha256=h,symbol=sym,operation_kind=op,component=comp,attempt_scope='incoming|outgoing exact attempt UNRESOLVED',account_scope='Manager accounting domain UNRESOLVED',backing_identity_rule=back,source_lease_identity_rule='UNRESOLVED',destination_lease_identity_rule='UNRESOLVED',capacity_rule='exact retained capacity; expression requires independent adjudication',reservation_site='UNRESOLVED',allocation_site=f'{path}:{line}',release_site='UNRESOLVED',borrow_alias_site=f'{path}:{line}' if op in ('BORROW','ALIAS') else '',transfer_site=f'{path}:{line}' if op=='TRANSFER' else '',terminal_paths='normal|empty|malformed|protocol|transport|timeout|cancel|refusal|STOP|RESTART|Shutdown|stale|race; mapping UNRESOLVED',baseline_row_id=base,delta=delta,provisional_class='UNRESOLVED',contrary_evidence='Independent reviewer must challenge hidden copy, alias escape, lease mismatch, release gap, and identity pairing.',rejection_condition='Reject if source bytes/site/operation/component/identity or lifecycle mapping is incorrect or incomplete.',authority_ceiling='STRUCTURAL_SOURCE_LOCATOR_ONLY; authority=0; no semantic acceptance or implementation authority',adjudicator_id='',adjudication_revision='',notes='mechanically enumerated; independent row adjudication required')\n57\t return r\n58\trows=[]\n59\tfor x in BASE+ALIASES+TERMINALS: rows.append(row(*x))\n60\t# Proposed successor relationships are exact architecture requirements, but source remains absent.\n61\tfor c in COMP:\n62\t for op,back in [('ALLOCATE',f'proposed owned {c} exact backing'),('ALIAS',f'proposed zero-charge bounded alias of {c} owning lease')]:\n63\t  rows.append(row(SIX[0],0,f'proposed.{c.lower()}.{op.lower()}',op,c,back,'ADDED'))\n64\trows.append(row(SIX[0],0,'proposed.transferDirectionalAcquisitionV2','TRANSFER','SELECTED_HANDOFF','atomic bytes plus complete lease-set transfer','ADDED'))\n65\trows.append(row(SIX[0],0,'proposed.releaseDirectionalTerminalV2','RELEASE','RETAINED_EXTERNAL_EVIDENCE','single terminal convergence release','ADDED'))\n66\trows.sort(key=lambda r:(r['delta'],r['source_path'],int(r['source_start_line']),r['operation_kind'],r['component']))\n67\t\n68\tdef write_tsv(name, selected):\n69\t with (OUT/name).open('w',newline='') as f:\n70\t  w=csv.DictWriter(f,FIELDS,delimiter='\\t',lineterminator='\\n'); w.writeheader(); w.writerows(selected)\n71\twrite_tsv('BASELINE_PRIOR_UNCHARGED.tsv',[r for r in rows if r['delta']=='UNCHANGED'])\n72\tfor d in ['ADDED','CHANGED','REMOVED','UNCHANGED']: write_tsv(d+'.tsv',[r for r in rows if r['delta']==d])\n73\twrite_tsv('ALLOCATION_SITES.tsv',[r for r in rows if r['operation_kind'] in ('ALLOCATE','COPY','RETAIN','PUBLISH')])\n74\twrite_tsv('RELEASE_SITES.tsv',[r for r in rows if r['operation_kind']=='RELEASE'])\n75\twrite_tsv('BORROW_ALIAS_SITES.tsv',[r for r in rows if r['operation_kind'] in ('BORROW','ALIAS')])\n76\twrite_tsv('TRANSFER_SITES.tsv',[r for r in rows if r['operation_kind']=='TRANSFER'])\n77\twrite_tsv('UNRESOLVED.tsv',rows)\n78\twith (OUT/'SOURCE_LOCATIONS.tsv').open('w',newline='') as f:\n79\t w=csv.writer(f,delimiter='\\t',lineterminator='\\n'); w.writerow(['source_path','line','symbol','operation_kind','component','row_id']); [w.writerow([r['source_path'],r['source_start_line'],r['symbol'],r['operation_kind'],r['component'],r['row_id']]) for r in rows]\n80\t# Exact source manifest for six paths and accepted inputs.\n81\tinputs=SIX+['docs/qualification/adr0011-c15-allocation-census.provisional.md','docs/qualification/adr0011-directional-raw-custody-c15-lease-source-v2-go-v1/C15_ENUMERATION_PLAN.md','docs/qualification/adr0011-directional-raw-custody-c15-lease-source-v2-go-v1/ARCHITECTURE.md','docs/qualification/adr0011-directional-raw-custody-c15-lease-source-v2-go-v1/WRITESET.md']\n82\twith (OUT/'SOURCE_MANIFEST.sha256').open('w') as f:\n83\t f.write(f'# HEAD {HEAD}\\n')\n84\t for p in inputs:\n85\t  q=ROOT/p\n86\t  f.write((f'{sha(p)}  {q.stat().st_size}  {p}' if q.exists() else f'ABSENT_REQUIRED_NEW  0  {p}')+'\\n')\n87\tcounts={d:sum(r['delta']==d for r in rows) for d in ['ADDED','CHANGED','REMOVED','UNCHANGED']}; counts.update(total_rows=len(rows),baseline_rows=sum(r['delta']=='UNCHANGED' for r in rows),current_candidate_rows=len(rows),unresolved=len(rows),duplicates=len(rows)-len({r['row_id'] for r in rows}),lineage_cycles=0,missing_predecessors=0,branches=0,genesis_errors=sum(not(r['revision']=='1' and r['predecessor_row_id']=='NULL' and r['predecessor_revision']=='0') for r in rows),status='ENUMERATION_COMPLETE_NOT_ADJUDICATED',authority=0)\n88\t(OUT/'COUNTS.json').write_text(json.dumps(counts,indent=2,sort_keys=True)+'\\n')\n89\t# Independent assignment intentionally contains every unresolved row.\n90\twrite_tsv('INDEPENDENT_ROW_ADJUDICATION_ASSIGNMENT.tsv',rows)\n91\t# Hash generated outputs except run manifest itself.\n92\tfiles=sorted(p for p in OUT.iterdir() if p.is_file() and p.name!='RUN_MANIFEST.sha256')\n93\twith (OUT/'RUN_MANIFEST.sha256').open('w') as f:\n94\t for p in files: f.write(f'{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.name}\\n')\n95\tprint(json.dumps(counts,sort_keys=True))\n\n## Related notes\n- 20261005230220-3632 — Integration receipt: Independently review ADR0011 C15 private owned-method-pair lease accounting, lifecycle joining, callback drain, refusal atomicity, and compatibility [possibly relevant]\n- 20261005000642-3335 — Integration receipt: Independently adjudicate bounded ADR0011 C15 private-B4 caller result lease Increment 1 [possibly relevant]\n- 20261004230052-1374 — Integration receipt: Independently adjudicate bounded ADR0011 C15 custodial private-B4 ingress params-copy accounting [possibly relevant]\n- 20260930025247-0850 — Integration receipt: Sole writer attempted private B4 V5 held capability replay in new b4.go/b4_test.go [possibly relevant]\n- 20261004222557-4857 — Integration receipt: Independent read-only integration review of ADR0011 C15 private-B4 returned request