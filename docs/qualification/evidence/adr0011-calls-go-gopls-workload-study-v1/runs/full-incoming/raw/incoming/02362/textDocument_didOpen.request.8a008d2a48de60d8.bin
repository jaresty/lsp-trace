{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///private/tmp/adr0011-gopls-workload-study-v1/workspace/internal/containment/platform_other.go","languageId":"go","version":1,"text":"//go:build !darwin && !linux && !windows\n\npackage containment\n\nimport \"runtime\"\n\nfunc platformProbe() runtimeResult {\n\tresult := unavailable(reasonUnsupportedPlatform, checkPlatformSupport)\n\tresult.platform = boundedPlatform(runtime.GOOS)\n\treturn result\n}\n"}}}