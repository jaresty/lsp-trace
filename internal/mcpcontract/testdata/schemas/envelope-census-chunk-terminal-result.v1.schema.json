{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/mcp/schemas/envelope-census-chunk-terminal-result.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_version", "envelope_schema_id", "tool", "request_id", "outcome", "operation_status", "isError", "custody_receipt"],
  "properties": {
    "envelope_version": {"const": "1"},
    "envelope_schema_id": {"const": "https://jaresty.github.io/lsp-trace/mcp/schemas/envelope-census-chunk-terminal-result.v1.schema.json"},
    "tool": {"const": "lsp_trace_v1_census"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "outcome": {"const": "COMPLETE"},
    "operation_status": {"const": "SUCCEEDED"},
    "isError": {"const": false},
    "custody_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "terminal_selector", "terminal_index_base64"],
      "properties": {
        "schema_version": {"const": "lsp-trace.census-chunk-terminal-custody-receipt.private.v1"},
        "terminal_selector": {"type": "string", "minLength": 1, "maxLength": 1024},
        "terminal_index_base64": {"type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    }
  }
}
