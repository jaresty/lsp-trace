{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/mcp/schemas/envelope-structural-context-domain-error.v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "target_recovery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "uri", "line", "character"],
          "properties": {
            "kind": {"const": "POSITION_LOCATOR"},
            "uri": {"type": "string", "pattern": "^file:"},
            "line": {"type": "integer", "minimum": 0},
            "character": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "required_fields"],
          "properties": {
            "kind": {"const": "POSITION_LOCATOR_TEMPLATE"},
            "required_fields": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"const": "uri"}, {"const": "line"}, {"const": "character"}], "items": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "required_pattern", "match_index", "required_fields", "limits"],
          "properties": {
            "kind": {"const": "REGEX_LOCATOR_TEMPLATE"},
            "uri": {"type": "string", "pattern": "^file:"},
            "required_pattern": {"const": true},
            "match_index": {"const": 0},
            "required_fields": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"const": "uri"}, {"const": "pattern"}, {"const": "match_index"}], "items": false},
            "limits": {"type": "object", "additionalProperties": false, "required": ["max_document_bytes", "max_matches", "max_pattern_bytes", "max_work"], "properties": {"max_document_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}, "max_matches": {"type": "integer", "minimum": 1, "maximum": 1000}, "max_pattern_bytes": {"type": "integer", "minimum": 1, "maximum": 4096}, "max_work": {"type": "integer", "minimum": 1, "maximum": 536870912}}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "unavailable_reason"],
          "properties": {
            "kind": {"const": "UNAVAILABLE"},
            "unavailable_reason": {"const": "NO_INDEPENDENTLY_VALID_LOCATOR"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "complete", "request_fragment", "omitted_fields"],
          "properties": {
            "kind": {"const": "SOURCE_ONLY_REQUEST_TEMPLATE"},
            "complete": {"const": false},
            "omitted_fields": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"const": "projection.privacy_policy_id"}], "items": false},
            "request_fragment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["session_id", "generation", "up_depth", "down_depth", "projection"],
              "properties": {
                "session_id": {"type": "string", "minLength": 1},
                "generation": {"type": "integer", "minimum": 1},
                "uri": {"type": "string", "pattern": "^file:"},
                "symbol": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 0},
                "character": {"type": "integer", "minimum": 0},
                "regex_locator": {"type": "object", "additionalProperties": false, "required": ["uri", "pattern", "match_index", "capture_group", "limits"], "properties": {"uri": {"type": "string", "pattern": "^file:"}, "pattern": {"type": "string", "minLength": 1, "maxLength": 4096}, "match_index": {"type": "integer", "minimum": 0, "maximum": 999}, "capture_group": {"type": "integer", "minimum": 0, "maximum": 32}, "expected_document_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "limits": {"type": "object", "additionalProperties": false, "required": ["max_document_bytes", "max_matches", "max_pattern_bytes", "max_work"], "properties": {"max_document_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}, "max_matches": {"type": "integer", "minimum": 1, "maximum": 1000}, "max_pattern_bytes": {"type": "integer", "minimum": 1, "maximum": 4096}, "max_work": {"type": "integer", "minimum": 1, "maximum": 536870912}}}}},
                "up_depth": {"const": 0},
                "down_depth": {"const": 0},
                "projection": {"type": "object", "additionalProperties": false, "required": ["mode", "body", "include_relation_occurrences"], "properties": {"mode": {"const": "TARGET"}, "body": {"enum": ["INCLUDE", "OMIT"]}, "include_relation_occurrences": {"const": false}}}
              },
              "oneOf": [
                {"required": ["uri", "line", "character"], "not": {"anyOf": [{"required": ["symbol"]}, {"required": ["regex_locator"]}]}},
                {"required": ["uri", "symbol"], "not": {"anyOf": [{"required": ["line"]}, {"required": ["character"]}, {"required": ["regex_locator"]}]}},
                {"required": ["regex_locator"], "not": {"anyOf": [{"required": ["uri"]}, {"required": ["symbol"]}, {"required": ["line"]}, {"required": ["character"]}]}}
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "envelope_version",
    "envelope_schema_id",
    "tool",
    "request_id",
    "outcome",
    "operation_status",
    "isError",
    "phase",
    "state",
    "error"
  ],
  "properties": {
    "envelope_version": { "const": "1" },
    "envelope_schema_id": { "const": "https://jaresty.github.io/lsp-trace/mcp/schemas/envelope-structural-context-domain-error.v4.schema.json" },
    "tool": { "const": "lsp_trace_v2_structural_context" },
    "request_id": { "type": "string", "pattern": "^sc_[0-9a-f]{32}$" },
    "outcome": { "const": "DOMAIN_ERROR" },
    "operation_status": { "const": "FAILED" },
    "isError": { "const": true },
    "phase": {
      "enum": [
        "PREFLIGHT",
        "TRAVERSAL",
        "ADMISSION",
        "DOCUMENT_ACQUISITION",
        "DISPLAY_RESOLUTION",
        "DELIVERY_CHECK"
      ]
    },
    "reason": {
      "enum": [
        "NO_REGEX_MATCH",
        "SOURCE_UNAVAILABLE",
        "DOCUMENT_OUTSIDE_WORKSPACE",
        "PREPARE_FAILED",
        "TRAVERSAL_FAILED"
      ]
    },
    "state": {
      "enum": [
        "UNSUPPORTED",
        "AMBIGUOUS_TARGET",
        "TARGET_NOT_FOUND",
        "PARTIAL",
        "TRUNCATED",
        "RESOURCE_LIMIT",
        "DOCUMENT_LIMIT",
        "DOCUMENT_UNAVAILABLE",
        "DOCUMENT_VERSION_CHANGED",
        "POLICY_WITHHELD",
        "TIMEOUT",
        "CANCELLED",
        "GENERATION_CHANGED",
        "INVALID_SERVER_RESPONSE",
        "SOURCE_UNAVAILABLE"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "method"],
      "properties": {
        "stage": { "enum": ["PREPARE", "OUTGOING", "INCOMING"] },
        "method": {
          "enum": [
            "textDocument/prepareCallHierarchy",
            "callHierarchy/outgoingCalls",
            "callHierarchy/incomingCalls"
          ]
        },
        "direction": { "enum": ["OUTGOING", "INCOMING"] },
        "depth": { "type": "integer", "minimum": 0, "maximum": 64 },
        "provider_method": { "enum": ["textDocument/prepareCallHierarchy", "callHierarchy/outgoingCalls", "callHierarchy/incomingCalls"] },
        "item_index": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "failed_field": { "enum": ["response", "item", "item.uri", "item.range", "item.selectionRange", "fromRanges"] },
        "failed_invariant": { "enum": ["ARRAY_RESULT", "REQUIRED_FIELD", "CONCRETE_DOCUMENT_URI", "RANGE_ORDER", "SELECTION_WITHIN_RANGE", "CALL_SITE_RANGE_ORDER"] },
        "provider_variant": { "enum": ["NON_ARRAY", "CALL_HIERARCHY_ITEM", "CALL_HIERARCHY_OUTGOING_CALL", "CALL_HIERARCHY_INCOMING_CALL"] },
        "projection_entered": { "const": false },
        "guidance": { "enum": ["RETRY_PROVIDER_OR_REPORT_MALFORMED_RESPONSE", "USE_TARGET_MODE_OR_FIX_PROVIDER_RESPONSE"] }
      },
      "allOf": [
        {
          "if": { "properties": { "stage": { "const": "PREPARE" } }, "required": ["stage"] },
          "then": {
            "properties": { "method": { "const": "textDocument/prepareCallHierarchy" } },
            "not": { "anyOf": [{ "required": ["direction"] }, { "required": ["depth"] }] }
          }
        },
        {
          "if": { "properties": { "stage": { "const": "OUTGOING" } }, "required": ["stage"] },
          "then": {
            "required": ["direction"],
            "properties": {
              "method": { "const": "callHierarchy/outgoingCalls" },
              "direction": { "const": "OUTGOING" }
            }
          }
        },
        {
          "if": { "properties": { "stage": { "const": "INCOMING" } }, "required": ["stage"] },
          "then": {
            "required": ["direction"],
            "properties": {
              "method": { "const": "callHierarchy/incomingCalls" },
              "direction": { "const": "INCOMING" }
            }
          }
        }
      ]
    },
    "target_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_matches", "total_symbols", "omitted_symbols", "action"],
      "properties": {
        "exact_matches": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "total_symbols": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "omitted_symbols": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "action": { "enum": ["FAIL_ABSENT", "ENUMERATION_TRUNCATED", "FAIL_AMBIGUOUS", "FAIL_MALFORMED", "FAIL_MISMATCH", "FAIL_UNSUPPORTED", "FAIL_DOCUMENT_SYMBOLS", "FAIL_UNPREPARABLE"] },
        "candidates": {"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["uri","name","kind","range"],"properties":{"uri":{"type":"string","pattern":"^file:"},"name":{"type":"string"},"kind":{"type":"integer","minimum":0},"container":{"type":"string"},"range":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"object","additionalProperties":false,"required":["line","character"],"properties":{"line":{"type":"integer","minimum":0},"character":{"type":"integer","minimum":0}}},"end":{"type":"object","additionalProperties":false,"required":["line","character"],"properties":{"line":{"type":"integer","minimum":0},"character":{"type":"integer","minimum":0}}}}}}}},
        "candidate_accounting": {"type":"object","additionalProperties":false,"required":["accepted","returned","excluded","deduplicated","truncated"],"properties":{"observed":{"type":"integer","minimum":0,"maximum":10000},"accepted":{"type":"integer","minimum":0,"maximum":10000},"returned":{"type":"integer","minimum":0,"maximum":10000},"excluded":{"type":"integer","minimum":0,"maximum":10000},"deduplicated":{"type":"integer","minimum":0,"maximum":10000},"truncated":{"type":"integer","minimum":0,"maximum":10000}}},
        "provider_method": {"enum":["workspace/symbol","textDocument/documentSymbol","textDocument/prepareCallHierarchy"]},
        "provider_adapter": {"type":"string","minLength":1,"maxLength":128},
        "item_index": {"type":"integer","minimum":0,"maximum":9999},
        "normalization_stage": {"enum":["PROVIDER_DECODE","POST_DECODE_NORMALIZATION","EXACT_MATCH"]},
        "failed_field": {"enum":["response","symbol","location.uri","location.range","range","kind"]},
        "failed_invariant": {"enum":["VALID_JSON","EXACT_MATCH_PRESENT","CONCRETE_DOCUMENT_URI","VALID_RANGE","RANGE_ORDER","WORKSPACE_CONFINED","VALID_DOCUMENT_SYMBOL_RANGE","CALLABLE_SYMBOL_KIND","POSITION_CONTAINMENT_PRESENT"]},
        "projection_entered": {"const":false},
        "locator_scope": {"enum":["LSP_SYMBOLS","URI_POSITION","DOCUMENT_SYMBOL_EXACT_NAME","REGEX_TO_POSITION"]},
        "guidance": {"type":"string","maxLength":256},
        "completeness": {"enum":["UNKNOWN"]},
        "recovery": {"$ref":"#/$defs/target_recovery"},
        "recoveries": {"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/target_recovery"}}
      }
    },
    "resource_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "field", "allowed"],
      "properties": {
        "reason": { "enum": ["NODE_BOUND", "REGEX_MAX_DOCUMENT_BYTES", "REGEX_MAX_PATTERN_BYTES", "REGEX_MAX_WORK", "REGEX_MAX_MATCHES"] },
        "field": { "enum": ["max_nodes", "regex_locator.limits.max_document_bytes", "regex_locator.limits.max_pattern_bytes", "regex_locator.limits.max_work", "regex_locator.limits.max_matches"] },
        "allowed": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "observed": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "maximum_allowed": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "suggested_limit": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "suggested_limits": {"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["field","current","observed","suggested"],"properties":{"field":{"enum":["max_nodes","regex_locator.limits.max_document_bytes","regex_locator.limits.max_pattern_bytes","regex_locator.limits.max_work","regex_locator.limits.max_matches"]},"current":{"type":"integer","minimum":1,"maximum":536870912},"observed":{"type":"integer","minimum":1,"maximum":536870913},"suggested":{"type":"integer","minimum":1,"maximum":536870912}}}},
        "caller_action": {"const":"REQUIRED"},
        "request_fragment": {"type":"object","additionalProperties":false,"properties":{"max_nodes":{"type":"integer","minimum":1,"maximum":10000},"regex_locator":{"type":"object","additionalProperties":false,"required":["limits"],"properties":{"limits":{"type":"object","additionalProperties":false,"properties":{"max_document_bytes":{"type":"integer","minimum":1,"maximum":16777216},"max_pattern_bytes":{"type":"integer","minimum":1,"maximum":4096},"max_work":{"type":"integer","minimum":1,"maximum":536870912},"max_matches":{"type":"integer","minimum":1,"maximum":1000}}}}}}}
      },
      "allOf": [
        { "if": { "properties": { "reason": { "const": "NODE_BOUND" } }, "required": ["reason"] }, "then": { "properties": { "field": { "const": "max_nodes" }, "maximum_allowed": { "const": 10000 } }, "required": ["maximum_allowed"] } },
        { "if": { "properties": { "reason": { "const": "REGEX_MAX_DOCUMENT_BYTES" } }, "required": ["reason"] }, "then": { "properties": { "field": { "const": "regex_locator.limits.max_document_bytes" }, "maximum_allowed": { "const": 16777216 } }, "required": ["maximum_allowed"] } },
        { "if": { "properties": { "reason": { "const": "REGEX_MAX_PATTERN_BYTES" } }, "required": ["reason"] }, "then": { "properties": { "field": { "const": "regex_locator.limits.max_pattern_bytes" }, "maximum_allowed": { "const": 4096 } }, "required": ["maximum_allowed"] } },
        { "if": { "properties": { "reason": { "const": "REGEX_MAX_WORK" } }, "required": ["reason"] }, "then": { "properties": { "field": { "const": "regex_locator.limits.max_work" }, "maximum_allowed": { "const": 536870912 } }, "required": ["maximum_allowed"] } },
        { "if": { "properties": { "reason": { "const": "REGEX_MAX_MATCHES" } }, "required": ["reason"] }, "then": { "properties": { "field": { "const": "regex_locator.limits.max_matches" }, "maximum_allowed": { "const": 1000 } }, "required": ["maximum_allowed"] } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["diagnostic"] },
      "then": {
        "properties": {
          "phase": { "const": "TRAVERSAL" },
          "state": { "const": "INVALID_SERVER_RESPONSE" },
          "error": {
            "properties": { "code": { "const": "INVALID_SERVER_RESPONSE" } },
            "required": ["code"]
          }
        },
        "not": { "required": ["target_diagnostic"] }
      }
    },
    {
      "if": { "required": ["target_diagnostic"] },
      "then": {
        "properties": { "phase": { "const": "PREFLIGHT" } },
        "not": { "anyOf": [{ "required": ["diagnostic"] }, { "required": ["resource_diagnostic"] }] }
      }
    },
    {
      "if": { "required": ["resource_diagnostic"] },
      "then": {
        "properties": {
          "state": { "enum": ["RESOURCE_LIMIT", "TRUNCATED"] },
          "error": { "properties": { "code": { "enum": ["RESOURCE_LIMIT", "TRUNCATED"] } }, "required": ["code"] }
        },
        "not": { "anyOf": [{ "required": ["diagnostic"] }, { "required": ["target_diagnostic"] }] }
      }
    }
  ]
}
