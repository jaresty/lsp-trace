    "event":{"type":"object","additionalProperties":false,"required":["event_seq","kind"],"properties":{"event_seq":{"$ref":"#/$defs/positive"},"kind":{"enum":["startup","initialize","crash","poison","request_admitted","lsp_dispatch","lsp_response","cancel","cancel_write_failed","timeout","tombstone","late_response_discarded"]},"session_id":{"$ref":"#/$defs/id"},"generation":{"$ref":"#/$defs/positive"},"manager_request_id":{"$ref":"#/$defs/id"},"lsp_request_id":{"$ref":"#/$defs/id"}}},
    "mcp":{"type":"object","additionalProperties":false,"required":["simulated_reference","step","operation","joined","replayed","noop"],"properties":{"simulated_reference":{"const":true},"step":{"type":"integer","minimum":0},"operation":{"enum":["lifecycle_register","lifecycle","lifecycle_complete","lifecycle_detach","admit","evict_complete"]},"kind":{"type":"string","minLength":1,"maxLength":256},"session_id":{"$ref":"#/$defs/id"},"victim":{"$ref":"#/$defs/id"},"reservation_id":{"$ref":"#/$defs/id"},"state":{"$ref":"#/$defs/state"},"prior_state":{"$ref":"#/$defs/state"},"generation":{"$ref":"#/$defs/positive"},"intent_id":{"$ref":"#/$defs/id"},"intent_kind":{"$ref":"#/$defs/intent_kind"},"outcome":{"enum":["COMPLETE","DOMAIN_ERROR","CANCELLED","TIMED_OUT"]},"operation_status":{"enum":["SUCCEEDED","FAILED","NOOP","CANCELLED","TIMED_OUT"]},"failure":{"$ref":"#/$defs/failure"},"joined":{"type":"boolean"},"replayed":{"type":"boolean"},"noop":{"type":"boolean"},"detached":{"type":"boolean"}}},
    "ownership":{"type":"object","additionalProperties":false,"required":["session_id","generation","manager_request_id","response_state","cancel_state"],"properties":{"session_id":{"$ref":"#/$defs/id"},"generation":{"$ref":"#/$defs/positive"},"manager_request_id":{"$ref":"#/$defs/id"},"lsp_request_id":{"$ref":"#/$defs/id"},"parent_manager_request_id":{"$ref":"#/$defs/id"},"ordinal":{"$ref":"#/$defs/positive"},"response_state":{"enum":["UNRESOLVED","RESPONDED","TOMBSTONED"]},"cancel_state":{"enum":["NOT_REQUESTED","SENT","WRITE_FAILED"]},"dispatch_event_seq":{"$ref":"#/$defs/positive"},"response_event_seq":{"$ref":"#/$defs/positive"},"cancel_event_seq":{"$ref":"#/$defs/positive"},"terminal_event_seq":{"$ref":"#/$defs/positive"},"tombstone_event_seq":{"$ref":"#/$defs/positive"}}},
    "intent":{"type":"object","additionalProperties":false,"required":["event_seq","session_id","generation","action","state"],"properties":{"event_seq":{"$ref":"#/$defs/positive"},"session_id":{"$ref":"#/$defs/id"},"generation":{"$ref":"#/$defs/positive"},"action":{"enum":["register","admit","stale","status","conflict","resource-exhausted","join","replay","noop","reap-incomplete","invariant-failure","insert","death","drain","reap","poison","allocate","initialized","ready","bind","terminal","detach","completion-conflict","initialization-discarded","initialization-stale","poison-stale"]},"intent_id":{"$ref":"#/$defs/id"},"caller_id":{"$ref":"#/$defs/id"},"state":{"$ref":"#/$defs/state"},"intent_kind":{"$ref":"#/$defs/intent_kind"},"failure":{"$ref":"#/$defs/failure"}}},
