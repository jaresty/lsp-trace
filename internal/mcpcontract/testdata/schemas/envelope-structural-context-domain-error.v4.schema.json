{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/mcp/schemas/envelope-structural-context-domain-error.v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "envelope_schema_id",
    "tool",
    "request_id",
    "outcome",
    "operation_status",
    "isError",
    "phase",
    "state",
    "error"
  ],
  "properties": {
    "envelope_version": { "const": "1" },
    "envelope_schema_id": { "const": "https://jaresty.github.io/lsp-trace/mcp/schemas/envelope-structural-context-domain-error.v4.schema.json" },
    "tool": { "const": "lsp_trace_v2_structural_context" },
    "request_id": { "type": "string", "pattern": "^sc_[0-9a-f]{32}$" },
    "outcome": { "const": "DOMAIN_ERROR" },
    "operation_status": { "const": "FAILED" },
    "isError": { "const": true },
    "phase": {
      "enum": [
        "PREFLIGHT",
        "TRAVERSAL",
        "ADMISSION",
        "DOCUMENT_ACQUISITION",
        "DISPLAY_RESOLUTION",
        "DELIVERY_CHECK"
      ]
    },
    "state": {
      "enum": [
        "UNSUPPORTED",
        "AMBIGUOUS_TARGET",
        "TARGET_NOT_FOUND",
        "PARTIAL",
        "TRUNCATED",
        "RESOURCE_LIMIT",
        "DOCUMENT_LIMIT",
        "DOCUMENT_UNAVAILABLE",
        "DOCUMENT_VERSION_CHANGED",
        "POLICY_WITHHELD",
        "TIMEOUT",
        "CANCELLED",
        "GENERATION_CHANGED",
        "INVALID_SERVER_RESPONSE"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "method"],
      "properties": {
        "stage": { "enum": ["PREPARE", "OUTGOING", "INCOMING"] },
        "method": {
          "enum": [
            "textDocument/prepareCallHierarchy",
            "callHierarchy/outgoingCalls",
            "callHierarchy/incomingCalls"
          ]
        },
        "direction": { "enum": ["OUTGOING", "INCOMING"] },
        "depth": { "type": "integer", "minimum": 0, "maximum": 64 }
      },
      "allOf": [
        {
          "if": { "properties": { "stage": { "const": "PREPARE" } }, "required": ["stage"] },
          "then": {
            "properties": { "method": { "const": "textDocument/prepareCallHierarchy" } },
            "not": { "anyOf": [{ "required": ["direction"] }, { "required": ["depth"] }] }
          }
        },
        {
          "if": { "properties": { "stage": { "const": "OUTGOING" } }, "required": ["stage"] },
          "then": {
            "required": ["direction"],
            "properties": {
              "method": { "const": "callHierarchy/outgoingCalls" },
              "direction": { "const": "OUTGOING" }
            }
          }
        },
        {
          "if": { "properties": { "stage": { "const": "INCOMING" } }, "required": ["stage"] },
          "then": {
            "required": ["direction"],
            "properties": {
              "method": { "const": "callHierarchy/incomingCalls" },
              "direction": { "const": "INCOMING" }
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "line", "character"],
          "properties": {
            "kind": { "const": "POSITION" },
            "line": { "type": "integer", "minimum": 0 },
            "character": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "symbol"],
          "properties": {
            "kind": { "const": "SYMBOL" },
            "symbol": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["diagnostic"] },
      "then": {
        "properties": {
          "phase": { "const": "TRAVERSAL" },
          "state": { "const": "INVALID_SERVER_RESPONSE" },
          "error": {
            "properties": { "code": { "const": "INVALID_SERVER_RESPONSE" } },
            "required": ["code"]
          }
        }
      }
    }
  ]
}
