{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://jaresty.github.io/lsp-trace/mcp/schemas/provenance-session.v1.schema.json","type":"object","additionalProperties":false,"required":["version","mcp_session_id","mcp_session_generation","mcp_session_key_digest","mcp_request_id","session_reused"],"properties":{"version":{"const":"1"},"mcp_session_id":{"type":"string","minLength":1,"maxLength":256},"mcp_session_generation":{"type":"integer","minimum":1},"mcp_session_key_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"mcp_request_id":{"type":"string","minLength":1,"maxLength":256},"session_reused":{"const":true}}}
