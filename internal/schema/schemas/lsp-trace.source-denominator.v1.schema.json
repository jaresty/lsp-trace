{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://jaresty.github.io/lsp-trace/schemas/lsp-trace.source-denominator.v1.schema.json",
  "title":"lsp-trace source denominator v1",
  "type":"object",
  "required":["denominator_schema_version","scope","scope_policy","derivation_policy","exclusions","covered_members","counts","logical_digest","semantic_validator","extractor_qualification"],
  "oneOf":[{"required":["members"],"not":{"required":["membership_commitment"]}},{"required":["membership_commitment"],"not":{"required":["members"]}}],
  "properties":{
    "denominator_schema_version":{"const":"lsp-trace.source-denominator.v1"},
    "scope":{"type":"object","required":["class","canonical_member_selector","inputs","source_manifest_digest","independently_bounded"],"properties":{"class":{"enum":["OPERATION_SCOPE","SOURCE_SNAPSHOT_SCOPE","SOURCE_COLLECTION_SCOPE"]},"canonical_member_selector":{"type":"string","minLength":1},"inputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"source_manifest_digest":{"$ref":"#/$defs/digest"},"independently_bounded":{"type":"boolean"}},"additionalProperties":false},
    "scope_policy":{"type":"object","required":["id","version"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}},"additionalProperties":false},
    "derivation_policy":{"type":"object","required":["id","version","basis"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"basis":{"const":"ADMITTED_SOURCE_MANIFEST"}},"additionalProperties":false},
    "members":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/member"}},
    "membership_commitment":{"type":"object","required":["digest","member_ids","equality_verified"],"properties":{"digest":{"$ref":"#/$defs/digest"},"member_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"equality_verified":{"const":true}},"additionalProperties":false},
    "exclusions":{"type":"array","items":{"type":"object","required":["member_id","reason"],"properties":{"member_id":{"type":"string","minLength":1},"reason":{"enum":["POLICY_EXCLUDED","UNAVAILABLE_SOURCE","UNSUPPORTED_SOURCE_KIND","OUTSIDE_REQUESTED_SCOPE"]}},"additionalProperties":false}},
    "covered_members":{"type":"array","items":{"type":"object","required":["member_id","evidence_ids"],"properties":{"member_id":{"type":"string","minLength":1},"evidence_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}},"additionalProperties":false}},
    "counts":{"type":"object","required":["universe","members","excluded","covered"],"properties":{"universe":{"type":"integer","minimum":0},"members":{"type":"integer","minimum":0},"excluded":{"type":"integer","minimum":0},"covered":{"type":"integer","minimum":0}},"additionalProperties":false},
    "logical_digest":{"$ref":"#/$defs/digest"},
    "semantic_validator":{"type":"object","required":["id","version","result"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"result":{"const":"PASS"}},"additionalProperties":false},
    "extractor_qualification":{"type":"object","required":["extractor_id","extractor_version","scope_policy_id","scope_policy_version","operation","status"],"properties":{"extractor_id":{"type":"string","minLength":1},"extractor_version":{"type":"string","minLength":1},"scope_policy_id":{"type":"string","minLength":1},"scope_policy_version":{"type":"string","minLength":1},"operation":{"const":"DENOMINATOR_DERIVATION"},"status":{"const":"PASS"}},"additionalProperties":false}
  },
  "$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"member":{"type":"object","required":["member_id"],"properties":{"member_id":{"type":"string","minLength":1}},"additionalProperties":false}},
  "additionalProperties":false
}
