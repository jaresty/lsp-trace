{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaresty.github.io/lsp-trace/schemas/lsp-trace.graph.v1.schema.json",
  "title": "lsp-trace graph v1",
  "type": "object",
  "required": ["schema_version", "invocation", "capabilities", "targets", "nodes", "edges", "terminals", "frontier", "diagnostics", "summary"],
  "properties": {
    "schema_version": {"const": "lsp-trace.graph.v1"},
    "invocation": {"type": "object"},
    "capabilities": {"type": "object"},
    "targets": {"type": ["array", "null"], "items": {"type": "string"}},
    "nodes": {"type": ["array", "null"], "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": ["array", "null"], "items": {"$ref": "#/$defs/edge"}},
    "terminals": {"type": ["array", "null"], "items": {"type": "object"}},
    "frontier": {"type": ["array", "null"], "items": {"type": "object"}},
    "diagnostics": {"type": ["array", "null"], "items": {"type": "object"}},
    "summary": {"type": "object"},
    "sibling_candidates": {"type": ["array", "null"]},
    "dispatch_relationships": {"type": ["array", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "position": {"type": "object", "required": ["line", "character"], "properties": {"line": {"type": "integer", "minimum": 0}, "character": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "range": {"type": "object", "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/position"}, "end": {"$ref": "#/$defs/position"}}, "additionalProperties": false},
    "node": {"type": "object", "required": ["id", "name", "kind", "uri", "range", "selection_range"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "integer"}, "detail": {"type": "string"}, "uri": {"type": "string"}, "range": {"$ref": "#/$defs/range"}, "selection_range": {"$ref": "#/$defs/range"}, "data": {}}, "additionalProperties": false},
    "edge": {"type": "object", "required": ["caller_node_id", "callee_node_id", "call_sites"], "properties": {"caller_node_id": {"type": "string"}, "callee_node_id": {"type": "string"}, "call_sites": {"type": ["array", "null"], "items": {"$ref": "#/$defs/range"}}}, "additionalProperties": false}
  }
}
