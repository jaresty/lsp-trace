line.startswith('#'):continue\n  parts=line.split('  '); h=parts[0]; rel=parts[-1]; q=(root/rel) if name=='SOURCE_MANIFEST.sha256' else (d/rel)\n  if h=='ABSENT_REQUIRED_NEW': ok=not q.exists()\n  else: ok=q.exists() and hashlib.sha256(q.read_bytes()).hexdigest()==h and (len(parts)<3 or int(parts[1])==q.stat().st_size)\n  if not ok: bad.append((line,str(q)))\n return bad\nu=rows(v1/'UNRESOLVED.tsv'); ident=rows(v2/'IDENTITY_ACCOUNTING_47_PLUS_1.tsv'); ex=rows(v2/'STAGE_A_EXISTING_SOURCE.tsv'); pl=rows(v2/'STAGE_A_PLANNED_OBLIGATIONS.tsv'); counts=json.loads((v2/'COUNTS.json').read_text())\nids={r['stage_a_row_id'] for r in pl}; missing=[]; edges={};\nfor r in pl:\n ps=[] if r['predecessor_lineage']=='GENESIS' else r['predecessor_lineage'].split('|'); edges[r['stage_a_row_id']]=ps; missing += [p for p in ps if p not in ids]\n# recompute IDs\nstable=lambda ns,*parts:hashlib.sha256((ns+'\\0'+'\\0'.join(parts)).encode()).hexdigest()\nbad_pl=[]\nfor r in pl:\n got=stable('adr0011.c15.two-stage.stage-a.planned.v1',r['proposed_source_path'],r['proposed_symbol'],r['status'],r['component'],r['attempt_account_lease_identity'])\n if got!=r['stage_a_row_id']:bad_pl.append(r['stage_a_row_id'])\nbad_ex=[]\nfor r in ex:\n got=stable('adr0011.c15.two-stage.stage-a.existing.v1',r['source_path'],r['symbol'],r['operation_kind'],r['component'])\n line=(root/r['source_path']).read_text().splitlines()[int(r['source_start_line'])-1].strip()\n if got!=r['stage_a_row_id'] or hashlib.sha256((root/r['source_path']).read_bytes()).hexdigest()!=r['source_sha256']:bad_ex.append((r['symbol'],line))\nprint('v1',len(u),len(set(r['row_id'] for r in u)),collections.Counter(r['status'] for r in u),hashlib.sha256((v1/'RUN_MANIFEST.sha256').read_bytes()).hexdigest())\nprint('identity',len(ident),collections.Counter(r['identity_kind'] for r in ident),'unique',len({r['identity'] for r in ident}),'preserved exact',{r['row_id'] for r in u}=={r['identity'] for r in ident if r['identity_kind']=='PRESERVED_V1_IDENTITY'})\nprint('existing',len(ex),'bad',bad_ex)\nprint('planned',len(pl),collections.Counter(r['status'] for r in pl),'bad ids',bad_pl,'missing preds',missing)\nprint('genesis',sum(r['predecessor_lineage']=='GENESIS' for r in pl),'all reachable?',len(ids)==len(edges))\nprint('stageb actual header',(v2/'STAGE_B_ACTUAL_CLASSIFICATION.tsv').read_text().strip())\nprint('stageb lineage header',(v2/'STAGE_B_PLANNED_ACTUAL_LINEAGE.tsv').read_text().strip())\nprint('counts',counts)\nprint('manifest bad v1run',verify_manifest(v1,'RUN_MANIFEST.sha256'))\nprint('manifest bad v2run',verify_manifest(v2,'RUN_MANIFEST.sha256'))\nprint('manifest bad v2source',verify_manifest(v2,'SOURCE_MANIFEST.sha256'))\nprint('v2runsha',hashlib.sha256((v2/'RUN_MANIFEST.sha256').read_bytes()).hexdigest())\nPY","timeout":120}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":17685,"output":1702,"cacheRead":90624,"cacheWrite":0,"reasoning":121,"totalTokens":110011,"cost":{"input":0.07074,"output":0.03404,"cacheRead":0.0362496,"cacheWrite":0,"total":0.1410296}},"stopReason":"toolUse","timestamp":1791905191116,"responseId":"resp_03201568652b0503016ace4da7a140819ba52b11d9e80ca5bb","rawStopReason":"completed","thinkingLevel":"minimal"},"timestamp":"2026-10-13T15:26:54.678Z","cwd":"/Users/schwa/dev/lsp-trace"}
